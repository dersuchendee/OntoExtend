<http://www.example.org/ontology> a owl:Ontology .

# ── Fragment 1: What materials does a fibre contain? ──

:Material rdf:type owl:Class ;
    rdfs:subClassOf ns4:Matter .

:Fibre rdf:type owl:Class ;
    rdfs:subClassOf :Material .

:containsMaterial rdf:type owl:ObjectProperty ;
    rdfs:domain :Fibre ;
    rdfs:range :MaterialComponent ;
    rdfs:subPropertyOf ns4:hasMaterialComponent .

:MaterialComponent rdf:type owl:Class ;
    rdfs:subClassOf ns4:MaterialComponent .

# ── Fragment 2: What are the properties of and data about that fibre? ──

:DataAboutFibre rdf:type owl:Class ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty ns6:statementAbout ;
        owl:someValuesFrom :Fibre
    ] .

:Fibre rdf:type owl:Class ;
    rdfs:subClassOf ns4:Material .

:hasProperty rdf:type owl:ObjectProperty ;
    rdfs:domain :Fibre ;
    rdfs:range owl:Thing . # GENERATED

:hasData rdf:type owl:ObjectProperty ;
    rdfs:domain :Fibre ;
    rdfs:range ns3:DataSheet . # GENERATED

# ── Fragment 3: When were material content and/or properties of this fiber changed? ──

:MaterialChangeEvent rdf:type owl:Class ;
    rdfs:subClassOf prov6:Activity . # GENERATED

:hasMaterialChange rdf:type owl:ObjectProperty ;
    rdfs:domain ns4:Material ;
    rdfs:range :MaterialChangeEvent . # GENERATED

:hasPropertyChange rdf:type owl:ObjectProperty ;
    rdfs:domain ns4:Material ;
    rdfs:range :MaterialChangeEvent . # GENERATED

:hasChangeTime rdf:type owl:DatatypeProperty ;
    rdfs:domain :MaterialChangeEvent ;
    rdfs:range xsd:dateTime . # GENERATED

ns4:Material rdf:type owl:Class .

ns6:MassFractionOfRecycledMaterialStatement rdf:type owl:Class ;
    rdfs:subClassOf ns6:MFOfPreConsumerRecycledMaterialContentStatement , 
                    ns6:MFOfPostConsumerRecycledMaterialContentStatement .

:MaterialChangeEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasChangeTime ;
    owl:someValuesFrom xsd:dateTime
] . # GENERATED
