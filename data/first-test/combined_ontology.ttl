<http://www.example.org/ontology> a owl:Ontology .

# ── Fragment 1: What materials does a fibre contain? ──

:Material rdf:type owl:Class ;
    rdfs:subClassOf ns4:Material .

:MaterialComponent rdf:type owl:Class ;
    rdfs:subClassOf ns4:MaterialComponent .

:Fibre rdf:type owl:Class ;
    rdfs:subClassOf :Material .

:containsMaterial rdf:type owl:ObjectProperty ;
    rdfs:domain :Fibre ;
    rdfs:range :MaterialComponent ;
    rdfs:label "contains material" ;
    rdfs:comment "Relates a fibre to the materials it contains." .

:hasMaterialComponent rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :containsMaterial ;
    rdfs:domain :Material ;
    rdfs:range :MaterialComponent ;
    rdfs:label "has material component" ;
    rdfs:comment "Indicates that a material has a component." .

# ── Fragment 2: What are the properties of and data about that fibre? ──

:DataAboutFibre rdf:type owl:Class ;
    rdfs:subClassOf ns3:DataSheet, [
        rdf:type owl:Restriction ;
        owl:onProperty ns6:statementAbout ;
        owl:someValuesFrom :Fibre
    ] ;
    rdfs:label "Data About Fibre" ;
    rdfs:comment "A class representing data about a specific fibre." .

:Fibre rdf:type owl:Class ;
    rdfs:subClassOf ns4:Material ;
    rdfs:label "Fibre" ;
    rdfs:comment "A class representing a fibre material." .

:PropertyOfFibre rdf:type owl:Class ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty ns6:statementAbout ;
        owl:someValuesFrom :Fibre
    ] ;
    rdfs:label "Property of Fibre" ;
    rdfs:comment "A class representing properties of a specific fibre." .

:hasProperty rdf:type owl:ObjectProperty ;
    rdfs:domain :Fibre ;
    rdfs:range :PropertyOfFibre ;
    rdfs:label "has property" ;
    rdfs:comment "Relates a fibre to its properties." .

:hasData rdf:type owl:ObjectProperty ;
    rdfs:domain :Fibre ;
    rdfs:range :DataAboutFibre ;
    rdfs:label "has data" ;
    rdfs:comment "Relates a fibre to its data." .

# ── Fragment 3: When were material content and/or properties of this fiber changed? ──

:MaterialChange a owl:Class ;
    rdfs:label "Material Change" ;
    rdfs:comment "A change in the material content or properties of a fiber." .

:hasMaterialChange a owl:ObjectProperty ;
    rdfs:label "has material change" ;
    rdfs:comment "Relates a fiber to a change in its material content or properties." ;
    rdfs:domain ns4:Material ;
    rdfs:range :MaterialChange .

:changeTime a owl:DatatypeProperty ;
    rdfs:label "change time" ;
    rdfs:comment "The time at which a material change occurred." ;
    rdfs:domain :MaterialChange ;
    rdfs:range xsd:dateTime .

:MaterialPropertyChange a owl:Class ;
    rdfs:label "Material Property Change" ;
    rdfs:comment "A change in the properties of a material." ;
    rdfs:subClassOf :MaterialChange .

:MaterialContentChange a owl:Class ;
    rdfs:label "Material Content Change" ;
    rdfs:comment "A change in the content of a material." ;
    rdfs:subClassOf :MaterialChange .

:hasMaterialPropertyChange a owl:ObjectProperty ;
    rdfs:label "has material property change" ;
    rdfs:comment "Relates a material to a change in its properties." ;
    rdfs:domain ns4:Material ;
    rdfs:range :MaterialPropertyChange .

:hasMaterialContentChange a owl:ObjectProperty ;
    rdfs:label "has material content change" ;
    rdfs:comment "Relates a material to a change in its content." ;
    rdfs:domain ns4:Material ;
    rdfs:range :MaterialContentChange .

:Material a owl:Class ;
    rdfs:subClassOf ns4:Material .

:hasChangeTime a owl:ObjectProperty ;
    rdfs:label "has change time" ;
    rdfs:comment "Relates a material change to the time it occurred." ;
    rdfs:domain :MaterialChange ;
    rdfs:range prov6:InstantaneousEvent . # GENERATED
