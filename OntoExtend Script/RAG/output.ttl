@prefix actor: <http://w3id.org/CEON/ontology/actor/> .
@prefix actorODP: <http://w3id.org/CEON/ontology/actorODP/> .
@prefix cvn: <http://w3id.org/CEON/ontology/cvn/> .
@prefix location: <http://w3id.org/CEON/ontology/location/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix processODP: <http://w3id.org/CEON/ontology/processODP/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix resourceODP: <http://w3id.org/CEON/ontology/resourceODP/> .
@prefix value: <http://w3id.org/CEON/ontology/value/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

actor:ActorCollaborationRole a owl:Class ;
    rdfs:label "Actor collaboration role"^^xsd:string ;
    rdfs:comment "The roles of an actor involved in a collaboration."^^xsd:string ;
    rdfs:subClassOf actorODP:Role .

actor:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:subClassOf actorODP:Actor .

actor:UsingResource a owl:Class ;
    rdfs:label "Using resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the user of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:user ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actorODP:participationIn a owl:ObjectProperty ;
    rdfs:label "participation in"^^xsd:string ;
    rdfs:comment "The collaboration or process that this participation relates to."^^xsd:string ;
    rdfs:domain actorODP:CollaborationParticipation ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( cvn:Collaboration processODP:Process ) ] .

<http://w3id.org/CEON/ontology/energy/hasEnergyComponentPercentage> a owl:DatatypeProperty ;
    rdfs:label "has energy component percentage"^^xsd:string ;
    rdfs:comment "hasEnergyComponentPercentage represents the percentage of a particular energy as a composition."^^xsd:string ;
    rdfs:domain <http://w3id.org/CEON/ontology/energy/EnergyComposition> ;
    rdfs:range xsd:double .

<http://w3id.org/CEON/ontology/product/hasCertificate> a owl:DatatypeProperty ;
    rdfs:label "has certificate"^^xsd:string ;
    rdfs:comment "Link to the the certificate that certifies the compliance"^^xsd:string ;
    rdfs:domain <http://w3id.org/CEON/ontology/product/Compliance> .

resourceODP:hasConstituent a owl:ObjectProperty ;
    rdfs:label "has constituent"^^xsd:string ;
    rdfs:comment "hasConstitutent intends to represent that a physical object can have a collection of composing components."^^xsd:string ;
    rdfs:domain resourceODP:PhysicalObject ;
    rdfs:range resourceODP:Constituent ;
    rdfs:subPropertyOf resourceODP:hasPart .

resourceODP:hasPhysicalObject a owl:ObjectProperty ;
    rdfs:label "has physical object"^^xsd:string ;
    rdfs:comment "hasPhysicalObject intends to represent that a batch of objects or a set of objects can have composing components of physical objects."^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( resourceODP:BatchOfObjects resourceODP:SetOfObjects ) ] ;
    rdfs:range resourceODP:PhysicalObject .

value:ValueParticipationRole a owl:Class ;
    rdfs:label "Value Participation Role"^^xsd:string ;
    rdfs:comment "A role that a value participant can take."^^xsd:string ;
    rdfs:subClassOf actorODP:Role .

value:targettingValueParticipation a owl:ObjectProperty ;
    rdfs:label "targetting value participation"^^xsd:string ;
    rdfs:comment "A value proposition is about some participation."^^xsd:string ;
    rdfs:domain value:ValueProposition ;
    rdfs:range value:ValueParticipation ;
    rdfs:subPropertyOf value:hasVPTargets .

actor:hasOrganisationName a owl:DatatypeProperty ;
    rdfs:label "Represent name of an organisation."^^xsd:string,
        "has organisation name"^^xsd:string ;
    rdfs:domain actor:Organisation ;
    rdfs:range xsd:string .

actorODP:participantRole a owl:ObjectProperty ;
    rdfs:label "participant role"^^xsd:string ;
    rdfs:comment "Holds the value of the role of the participant in this participation relation."^^xsd:string ;
    rdfs:domain actorODP:Participation ;
    rdfs:range actorODP:Role .

actorODP:participationStartTime a owl:DatatypeProperty ;
    rdfs:label "participation start time"^^xsd:string ;
    rdfs:comment "The start of a time interval."^^xsd:string ;
    rdfs:domain actorODP:Participation ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:date xsd:dateTime xsd:gMonthYear xsd:gYear ) ] .

actorODP:participationTimePoint a owl:DatatypeProperty ;
    rdfs:label "participation time point"^^xsd:string ;
    rdfs:comment "The point in time when something took place or was valid."^^xsd:string ;
    rdfs:domain actorODP:Participation ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:date xsd:dateTime xsd:gMonthYear xsd:gYear ) ] .

actor:Organisation a owl:Class ;
    rdfs:label "Organisation"@en ;
    rdfs:comment "Person or group of people that has its own functions with responsibilities, authorities, and relationships to achieve its objectives. The concept of organization includes, but is not limited to sole-trader, company, corporation, firm, enterprise, authority, partnership, charity or institution, or part or combination thereof, whether incorporated or not, public or private (e.g. foundation, union, association, agency, municipality, region, country, intergovernmental agencies). A group of organizations can also be considered as	an organization that has, alone or collectively,their own objectives."@en ;
    rdfs:isDefinedBy "ISO 59004:2024 - 3.4.1 organization"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty actor:hasOrganisationName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty actor:hasOrganisationLocation ;
                        owl:someValuesFrom actor:OrganisationLocation ] [ a owl:Restriction ;
                        owl:allValuesFrom actor:OrganisationLocation ;
                        owl:onProperty actor:hasOrganisationLocation ] ) ],
        actorODP:Actor .

actor:hasOrganisationLocation a owl:ObjectProperty ;
    rdfs:label "has organisation location"^^xsd:string ;
    rdfs:comment "Represent that an organisation has some locations."^^xsd:string ;
    rdfs:domain actor:Organisation ;
    rdfs:range actor:OrganisationLocation ;
    rdfs:subPropertyOf location:hasLocation .

actorODP:Actor a owl:Class ;
    rdfs:label "Actor"^^xsd:string ;
    rdfs:comment "An agent able to act in the context of a circular value network, e.g. an organisation, person."^^xsd:string .

actor:OrganisationLocation a owl:Class ;
    rdfs:label "Organisation Location"^^xsd:string ;
    rdfs:comment "Location of an organisation"^^xsd:string ;
    rdfs:subClassOf location:Location .

actorODP:Participation a owl:Class ;
    rdfs:label "Participation"^^xsd:string ;
    rdfs:comment "Represents the participation of objects in some situation."^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty actorODP:participationStartTime ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty actorODP:participationTimePoint ] ) ] .

