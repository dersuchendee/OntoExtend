@prefix actor: <http://w3id.org/CEON/ontology/actor/> .
@prefix actorODP: <http://w3id.org/CEON/ontology/actorODP/> .
@prefix cvn: <http://w3id.org/CEON/ontology/cvn/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix location: <http://w3id.org/CEON/ontology/location/> .
@prefix odp: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix processODP: <http://w3id.org/CEON/ontology/processODP/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudt-unit: <http://qudt.org/vocab/unit/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix resourceODP: <http://w3id.org/CEON/ontology/resourceODP/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix value: <http://w3id.org/CEON/ontology/value/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

dcterms:contributor a owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty,
        owl:AnnotationProperty .

qudt-unit:EURO-PER-KiloM a qudt:Unit,
        owl:NamedIndividual ;
    rdfs:label "Euro Per Kilometer"^^xsd:string ;
    dcterms:description "Euro Per Kilometer (€/km) is a unit used to represent the cost or value associated with transporting a resource."^^rdf:HTML ;
    qudt:symbol "€/km"^^xsd:string .

qudt-unit:EURO-PER-M2 a qudt:Unit,
        owl:NamedIndividual ;
    rdfs:label "Euro Per Square Meter"^^xsd:string ;
    dcterms:description "Euro Per Square Meter (€/km) is a unit used to represent the cost or value of resource per square meter."^^rdf:HTML ;
    qudt:symbol "€/m²"^^xsd:string .

actor: a owl:Ontology ;
    dcterms:contributor "Eva Blomqvist"^^xsd:string,
        "Mikael Lindecrantz"^^xsd:string,
        "Robin Keskisärkkä"^^xsd:string ;
    dcterms:created "2024-11-13"^^xsd:date ;
    dcterms:creator "Huanyu Li"^^xsd:string ;
    dcterms:description "The Actor module of CEON (Circular Economy Ontology Network)."^^xsd:string ;
    dcterms:issued "2025-06-30"^^xsd:date ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:string ;
    dcterms:publisher "Onto-DESIDE"^^xsd:string ;
    dcterms:title "Circular Economy Ontology Network (CEON) - Actor Module"^^xsd:string ;
    vann:preferredNamespacePrefix "ceon-actor"^^xsd:string ;
    vann:preferredNamespaceUri "http://w3id.org/CEON/ontology/actor/"^^xsd:string ;
    odp:coversRequirements "In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.1: C0-1, C0-2, C3-4, T3-4."^^xsd:string,
        "In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.2: C0-1, C0-2, C3-4, T3-4."^^xsd:string ;
    rdfs:seeAlso <https://github.com/LiUSemWeb/CEON> ;
    owl:imports <http://w3id.org/CEON/ontology/actorODP/0.4/> ;
    owl:priorVersion 0.3 ;
    owl:versionIRI <http://w3id.org/CEON/ontology/actor/0.4/> ;
    owl:versionInfo 0.4 .

actor:BuyingResource a owl:Class ;
    rdfs:label "Buying resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the buyer of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:buyer ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:CVNParticipation a owl:Class ;
    rdfs:label "Circular Value Network Participation"^^xsd:string ;
    rdfs:comment "A participation-relation, that represents the participation of an actor in a CVN with a certain role. For instance, a specific company playing the role of recycler in a certain flow of a CVN. The participation may also be related to a certain time (or time interval)."^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( actorODP:CollaborationParticipation [ a owl:Restriction ;
                        owl:onProperty actorODP:participantRole ;
                        owl:someValuesFrom actor:ActorCVNRole ] [ a owl:Restriction ;
                        owl:onProperty actorODP:participatingActor ;
                        owl:someValuesFrom actorODP:Actor ] [ a owl:Restriction ;
                        owl:onProperty actorODP:participationIn ;
                        owl:someValuesFrom cvn:CVN ] ) ],
        actorODP:CollaborationParticipation .

actor:ConsumingResource a owl:Class ;
    rdfs:label "Consuming resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the consumer of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:consumer ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:DismantlingResource a owl:Class ;
    rdfs:label "Dismantling resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the dismantler of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:dismantler ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:IssuingResource a owl:Class ;
    rdfs:label "Issuing resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the issuer of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:issuer ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:ManufacturingResource a owl:Class ;
    rdfs:label "Manufacturing resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the manufacturer of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:manufacturer ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:OwningResource a owl:Class ;
    rdfs:label "Owning resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the owner of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:owner ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:ProcessParticipation a owl:Class ;
    rdfs:label "Process Participation"^^xsd:string ;
    rdfs:comment "Participation of a certain actor in a certain process, with a certain role. For instance, a certain department of a recycling company having the role of quality controllant, or material sorter, in a certain recycling process. The participation may also be given a time, e.g. a start and end time."^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( actorODP:CollaborationParticipation [ a owl:Restriction ;
                        owl:onProperty actorODP:participantRole ;
                        owl:someValuesFrom actor:ActorProcessRole ] [ a owl:Restriction ;
                        owl:onProperty actorODP:participatingActor ;
                        owl:someValuesFrom actorODP:Actor ] [ a owl:Restriction ;
                        owl:onProperty actorODP:participationIn ;
                        owl:someValuesFrom processODP:Process ] ) ],
        actorODP:CollaborationParticipation .

actor:ProducingResource a owl:Class ;
    rdfs:label "Producing resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the producer of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:producer ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:ProvidingResource a owl:Class ;
    rdfs:label "Providing resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the provider of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:provider ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:RecyclingResource a owl:Class ;
    rdfs:label "Recycling resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the recycler of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:recycler ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:RepairingResource a owl:Class ;
    rdfs:label "Repairing resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the repairer of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:repairer ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:ResellingResource a owl:Class ;
    rdfs:label "Reselling resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the reseller of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:reseller ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:SellingResource a owl:Class ;
    rdfs:label "Selling resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the seller of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:seller ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:Stakeholder a owl:Class ;
    rdfs:label "Interested Party"^^xsd:string,
        "Stakeholder"@en ;
    rdfs:comment "Person or organization that can affect, be affected by, or perceive itself to be affected by a decision or activity. To “perceive itself to be affected” means the perception has been made known to the organization."@en ;
    rdfs:isDefinedBy "ISO 59004:2024 - 3.4.2 interested party, stakeholder"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( actor:Organisation actor:Person ) ] .

actor:SupplyingResource a owl:Class ;
    rdfs:label "Supplying resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the supplier of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:supplier ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:TakingBackResource a owl:Class ;
    rdfs:label "Taking back resource"^^xsd:string,
        "The relation where the role of the actor is the collector of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:collector ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:UpdatingResource a owl:Class ;
    rdfs:label "Updating resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the updater of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:updater ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:UsingResource a owl:Class ;
    rdfs:label "Using resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the user of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:user ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:ViewingResource a owl:Class ;
    rdfs:label "Viewing resource"^^xsd:string ;
    rdfs:comment "The relation where the role of the actor is the viewer of a certain resource."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( actorODP:ResourceRelation [ a owl:Restriction ;
                        owl:hasValue actor:viewer ;
                        owl:onProperty actorODP:participantRole ] ) ] .

actor:capabilityExtent a owl:ObjectProperty ;
    rdfs:label "capability extent"^^xsd:string ;
    rdfs:comment "The extent of this capability, e.g. stating whether there are limist to the capability, such as a maximum amount or size of something."^^xsd:string ;
    rdfs:domain actorODP:Capability ;
    rdfs:subPropertyOf actorODP:capabilityProperty .

actor:neededResourceRelation a owl:ObjectProperty ;
    rdfs:label "needed resource relations"^^xsd:string ;
    rdfs:comment "In order for an actor to have a capability, it needs to have certain resources, e.g. materials, infrastrucutre, know-how, information etc."^^xsd:string ;
    rdfs:domain actorODP:Capability ;
    rdfs:subPropertyOf actorODP:capabilityProperty .

actorODP: a owl:Ontology ;
    dcterms:contributor "Eva Blomqvist"^^xsd:string,
        "Mikael Lindecrantz"^^xsd:string,
        "Robin Keskisärkkä"^^xsd:string ;
    dcterms:created "2025-05-20"^^xsd:date ;
    dcterms:creator "Huanyu Li"^^xsd:string ;
    dcterms:description "A core ODP of the CEON ontology network, defining aspects of the actor concept."^^xsd:string ;
    dcterms:issued "2025-06-30"^^xsd:date ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:string ;
    dcterms:publisher "Onto-DESIDE"^^xsd:string ;
    dcterms:title "Circular Economy Ontology Network (CEON) - Actor ODP"^^xsd:string ;
    vann:preferredNamespacePrefix "ceon-actorODP"^^xsd:string ;
    vann:preferredNamespaceUri "http://w3id.org/CEON/ontoloy/actorODP/"^^xsd:string ;
    odp:coversRequirements "Covers the following requirements from Onto-DESIDE D3.1: CVN-Process-3, CVN-Actor-1,4,6,7, CVN-Competency-3, CVN-Information-4, C11-1, C11-3, E1-6,6,6,9, E4-10."^^xsd:string,
        "Covers the following requirements from Onto-DESIDE D3.2: CE1-1, CE2-1, CE2-2, CE4-2, CE6-3, CE12-1, CE10-1, CE10-3, CE10-4, CE10-9, C3-6, C3-9, C11-1, C11-3, C13-8, C13-10, E1-6, E1-9, E4-10."^^xsd:string ;
    rdfs:comment "A core ODP of the CEON ontology network, defining aspects of the actor concept."^^xsd:string ;
    rdfs:seeAlso <https://github.com/LiUSemWeb/CEON> ;
    owl:priorVersion 0.3 ;
    owl:versionIRI <http://w3id.org/CEON/ontology/actorODP/0.4/> ;
    owl:versionInfo 0.4 .

actorODP:basedOnCapability a owl:ObjectProperty ;
    rdfs:label "based on capability"^^xsd:string ;
    rdfs:comment "An actor participates in a collaboration based on that it has some capability that is useful for the collaboration."^^xsd:string ;
    rdfs:domain actorODP:CollaborationParticipation ;
    rdfs:range actorODP:Capability .

actorODP:capabilityOf a owl:ObjectProperty ;
    rdfs:label "capability of"^^xsd:string ;
    rdfs:comment "Relates to the actor holding the capability."^^xsd:string ;
    rdfs:domain actorODP:Capability ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( actorODP:Actor actorODP:Infrastructure ) ] .

actorODP:participatingInfrastructure a owl:ObjectProperty ;
    rdfs:label "participating infrastructure"^^xsd:string ;
    rdfs:comment "Holds the value of the infrastructure involved in this participation relation."^^xsd:string ;
    rdfs:domain actorODP:Participation ;
    rdfs:range actorODP:Infrastructure .

actorODP:participationEndTime a owl:DatatypeProperty ;
    rdfs:label "participation end time"^^xsd:string ;
    rdfs:comment "The end of a time interval."^^xsd:string ;
    rdfs:domain actorODP:Participation ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:date xsd:dateTime xsd:gMonthYear xsd:gYear ) ] .

cvn: a owl:Ontology ;
    dcterms:contributor "Eva Blomqvist"^^xsd:string,
        "Mikael Lindecrantz"^^xsd:string,
        "Robin Keskisärkkä"^^xsd:string ;
    dcterms:created "2025-05-22"^^xsd:date ;
    dcterms:creator "Huanyu Li"^^xsd:string ;
    dcterms:description "A core module of the CEON ontology network, defining aspects of the circular value network (CVN) itself."^^xsd:string ;
    dcterms:issued "2025-06-30"^^xsd:date ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:string ;
    dcterms:publisher "Onto-DESIDE"^^xsd:string ;
    dcterms:title "Circular Economy Ontology Network (CEON) - Circular Value Network Module"^^xsd:string ;
    vann:preferredNamespacePrefix "ceon-cvn"^^xsd:string ;
    vann:preferredNamespaceUri "http://w3id.org/CEON/ontoloy/cvn/"^^xsd:string ;
    odp:coversRequirements "In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.1: CVN-CVN-1, CVN-Process-1,6, CVN-VP-1, CVN-Type-3, C0-1."^^xsd:string,
        "In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.2: CE1-1, CE2-1, CE3-1, CE3-2, CE4-1, CE5-16, C0-1."^^xsd:string ;
    rdfs:comment "A core module of the CEON ontology network, defining aspects of the circular value network (CVN) itself."^^xsd:string ;
    rdfs:seeAlso <https://github.com/LiUSemWeb/CEON> ;
    owl:imports <http://w3id.org/CEON/ontology/actor/0.4/> ;
    owl:priorVersion 0.2 ;
    owl:versionIRI <http://w3id.org/CEON/ontology/cvn/0.3/> ;
    owl:versionInfo 0.3 .

cvn:aimsAtValue a owl:ObjectProperty ;
    rdfs:label "aims at value"^^xsd:string ;
    rdfs:comment "The value proposition that the planned abstract CVN configuration, or concrete network wants to achieve."^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cvn:CVN cvn:CVNBlueprint ) ] ;
    rdfs:range value:ValueProposition .

cvn:composedOf a owl:ObjectProperty ;
    rdfs:label "composed of"^^xsd:string ;
    rdfs:comment "Both a CVN and a process can be composed of other CVNs or processes."^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cvn:CVN processODP:Process ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( cvn:CVN processODP:Process ) ] .

cvn:createsValue a owl:ObjectProperty ;
    rdfs:label "creates value"^^xsd:string ;
    rdfs:comment "Value creation can be captured at the actor level, i.e. value created by an actor's participation in a collaboration, or at the process or complete CVN level."^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( actorODP:Participation cvn:CVN processODP:Process ) ] ;
    rdfs:range value:Value .

cvn:implementsBlueprint a owl:ObjectProperty ;
    rdfs:label "implements blueprint"^^xsd:string ;
    rdfs:comment "The blueprint (or plan) that this concrete CVN is an instance of."^^xsd:string ;
    rdfs:domain cvn:CVN ;
    rdfs:range cvn:CVNBlueprint .

cvn:implementsStrategy a owl:ObjectProperty ;
    rdfs:label "implements strategy"^^xsd:string ;
    rdfs:comment "A strategy that is implemented by this CVN or CVN blueprint."^^xsd:string ;
    rdfs:domain cvn:CVN ;
    rdfs:range cvn:CircularStrategy ;
    rdfs:subPropertyOf cvn:relatedStrategy .

cvn:plansToImplementStrategy a owl:ObjectProperty ;
    rdfs:label "plans to implement strategy"^^xsd:string ;
    rdfs:comment "A strategy that is planned to be implemented by this CVN or CVN blueprint."^^xsd:string ;
    rdfs:domain cvn:CVNBlueprint ;
    rdfs:range cvn:CircularStrategy ;
    rdfs:subPropertyOf cvn:relatedStrategy .

<http://w3id.org/CEON/ontology/energy/> a owl:Ontology ;
    dcterms:contributor "Eva Blomqvist"^^xsd:string ;
    dcterms:created "2025-03-20"^^xsd:string ;
    dcterms:creator "Huanyu Li"^^xsd:string ;
    dcterms:description "A module of the CEON ontology network defining aspects of the energy concept."^^xsd:string ;
    dcterms:issued "2025-06-30"^^xsd:date ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:string ;
    dcterms:publisher "Onto-DESIDE"^^xsd:string ;
    dcterms:title "Circular Economy Ontology Network (CEON) - Energy Module"^^xsd:string ;
    vann:preferredNamespacePrefix "ceon-energy"^^xsd:string ;
    vann:preferredNamespaceUri "http://w3id.org/CEON/ontology/energy/"^^xsd:string ;
    odp:coversRequirements "Covers the following requirements from Onto-DESIDE D3.2: CE1-2, CE4-3, CE6-3, CE7-4, CE7-4, CE8-2, CE9-2, CE10-7, CE10-9, CE11-6, CE12-5."^^xsd:string ;
    rdfs:seeAlso <https://github.com/LiUSemWeb/CEON> ;
    owl:imports <http://w3id.org/CEON/ontology/actorODP/0.4/>,
        <http://w3id.org/CEON/ontology/resourceODP/0.5/> ;
    owl:priorVersion 0.1 ;
    owl:versionIRI <http://w3id.org/CEON/ontology/energy/0.2/> ;
    owl:versionInfo 0.2 .

<http://w3id.org/CEON/ontology/energy/Biofuel> a owl:Class ;
    rdfs:label "Biofuel"^^xsd:string ;
    rdfs:comment "Biofuel is a fuel that is produced over a short time span from biomass."^^xsd:string ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Biofuel"^^xsd:string ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/energy/Biomass> .

<http://w3id.org/CEON/ontology/energy/Biogas> a owl:Class ;
    rdfs:label "Biogass"^^xsd:string ;
    rdfs:comment "Biogas represents an energy source that is produced from raw materials such as agricultural waste, manure, municipal waste, plant material, sewage, green waste, wastewater, and food waste."^^xsd:string ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Biogas"^^xsd:string ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/energy/Biomass> .

<http://w3id.org/CEON/ontology/energy/Coal> a owl:Class ;
    rdfs:label "Coal"^^xsd:string ;
    rdfs:comment "Coal is a black or dark-brown combustible mineral substance consisting of carbonized vegetable matter."^^xsd:string ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Coal"^^xsd:string ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/energy/FossilFuel> .

<http://w3id.org/CEON/ontology/energy/EnergyConversion> a owl:Class ;
    rdfs:label "Energy Conversion"^^xsd:string ;
    rdfs:comment "Energy Conversion is a process of transforming energy."^^xsd:string ;
    rdfs:subClassOf actorODP:ResourceRelation .

<http://w3id.org/CEON/ontology/energy/EnergyInfrastructure> a owl:Class ;
    rdfs:label "Energy Infrastructure"^^xsd:string ;
    rdfs:comment "The infrastructures participating in various energy-related processes, including energy production, transmission or distribution."^^xsd:string ;
    rdfs:subClassOf actorODP:Infrastructure .

<http://w3id.org/CEON/ontology/energy/GeothermalEnergySource> a owl:Class ;
    rdfs:label "Geothermal Energy Source"^^xsd:string ;
    rdfs:comment "Geothermal Energy Source is the Earth's crust. Geothermal energy is thermal energy extracted from the Earth's crust. It combines energy from the formation of the planet and from radioactive decay."^^xsd:string ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Geothermal_energy"^^xsd:string ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/energy/EnergySource> .

<http://w3id.org/CEON/ontology/energy/Hydropower> a owl:Class ;
    rdfs:label "Hydropower"^^xsd:string ;
    rdfs:comment "Hydropower is the use of falling or fast-running water to produce electricity or to power machines."^^xsd:string ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Hydropower"^^xsd:string ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/energy/EnergySource> .

<http://w3id.org/CEON/ontology/energy/NaturalGas> a owl:Class ;
    rdfs:label "Natural Gas"^^xsd:string ;
    rdfs:comment "Natural gas is a combustible gas that is naturally generated and stored under certain geological conditions by ancient animals and plants buried deep underground. It is a gaseous mixture of hydrocarbons and non-hydrocarbons, with methane as its main component."^^xsd:string ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Natural_gas"^^xsd:string ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/energy/FossilFuel> .

<http://w3id.org/CEON/ontology/energy/Petroleum> a owl:Class ;
    rdfs:label "Petroleum"^^xsd:string ;
    rdfs:comment "Petroleum is a naturally occurring yellow-black liquid chemical mixture found in geological formations, consisting primarily of hydrocarbons."^^xsd:string ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Petroleum"^^xsd:string ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/energy/FossilFuel> .

<http://w3id.org/CEON/ontology/energy/SolarEnergySource> a owl:Class ;
    rdfs:label "Solar Energy Source"^^xsd:string ;
    rdfs:comment "Solar Energy Source is the Sun."^^xsd:string ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Solar_energy"^^xsd:string ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/energy/EnergySource> .

<http://w3id.org/CEON/ontology/energy/WindEnergySource> a owl:Class ;
    rdfs:label "Wind Energy Source"^^xsd:string ;
    rdfs:comment "Wind Energy Source is the Wind."^^xsd:string ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Wind_power"^^xsd:string ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/energy/EnergySource> .

<http://w3id.org/CEON/ontology/energy/hasAnergy> a owl:ObjectProperty ;
    rdfs:label "has anergy"^^xsd:string ;
    rdfs:comment "hasAnergy represents that energy has part of anergy."^^xsd:string ;
    rdfs:subPropertyOf actorODP:participatingObject .

<http://w3id.org/CEON/ontology/energy/hasCarbonIntensity> a owl:DatatypeProperty ;
    rdfs:label "has carbon intensity"^^xsd:string ;
    rdfs:comment "hasCarbonIntensity measures how intensive that the carbon is for an energy source."^^xsd:string ;
    rdfs:domain <http://w3id.org/CEON/ontology/energy/EnergySource> ;
    rdfs:range xsd:double .

<http://w3id.org/CEON/ontology/energy/hasConvertedEnergy> a owl:ObjectProperty ;
    rdfs:label "has converted energy"^^xsd:string ;
    rdfs:comment "hasConvertedEnergy represents that an energy transformation process has its final energy."^^xsd:string ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://w3id.org/CEON/ontology/energy/NonRenewableEnergy> <http://w3id.org/CEON/ontology/energy/RenewableEnergy> ) ] ;
    rdfs:subPropertyOf actorODP:participatingResource .

<http://w3id.org/CEON/ontology/energy/hasEnergyComponentPercentage> a owl:DatatypeProperty ;
    rdfs:label "has energy component percentage"^^xsd:string ;
    rdfs:comment "hasEnergyComponentPercentage represents the percentage of a particular energy as a composition."^^xsd:string ;
    rdfs:domain <http://w3id.org/CEON/ontology/energy/EnergyComposition> ;
    rdfs:range xsd:double .

<http://w3id.org/CEON/ontology/energy/hasEnergySource> a owl:ObjectProperty ;
    rdfs:label "has energy source"^^xsd:string ;
    rdfs:comment "hasEnergySource represents that energy can have some energy sources."^^xsd:string ;
    rdfs:domain <http://w3id.org/CEON/ontology/energy/Energy> ;
    rdfs:range <http://w3id.org/CEON/ontology/energy/EnergySource> .

<http://w3id.org/CEON/ontology/energy/hasExergy> a owl:ObjectProperty ;
    rdfs:label "has exergy"^^xsd:string ;
    rdfs:comment "hasExergy represents that energy has part of exergy."^^xsd:string ;
    rdfs:subPropertyOf actorODP:participatingObject .

<http://w3id.org/CEON/ontology/energy/hasOriginalEnergy> a owl:ObjectProperty ;
    rdfs:label "has original energy"^^xsd:string ;
    rdfs:comment "hasOriginalEnergy represents that an energy transformation process has its initial energy."^^xsd:string ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://w3id.org/CEON/ontology/energy/NonRenewableEnergy> <http://w3id.org/CEON/ontology/energy/RenewableEnergy> ) ] ;
    rdfs:subPropertyOf actorODP:participatingResource .

<http://w3id.org/CEON/ontology/energy/hasSustainability> a owl:DatatypeProperty ;
    rdfs:label "has sustainability"^^xsd:string ;
    rdfs:comment "hasSustainability measures how sustainable an energy source is."^^xsd:string ;
    rdfs:domain <http://w3id.org/CEON/ontology/energy/EnergySource> ;
    rdfs:range xsd:double .

<http://w3id.org/CEON/ontology/energy/participatingEnergy> a owl:ObjectProperty ;
    rdfs:label "participating energy"^^xsd:string ;
    rdfs:comment "participatingEnergy represents the energy in an energy composition."^^xsd:string ;
    rdfs:subPropertyOf actorODP:participatingSubject .

location: a owl:Ontology ;
    dcterms:contributor "Eva Blomqvist"^^xsd:string ;
    dcterms:created "2025-03-19"^^xsd:string ;
    dcterms:creator "Huanyu Li"^^xsd:string ;
    dcterms:description "A module the CEON ontology network, defining aspects of the location concept."^^xsd:string ;
    dcterms:issued "2025-06-30"^^xsd:date ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:string ;
    dcterms:publisher "Onto-DESIDE"^^xsd:string ;
    dcterms:title "Circular Economy Ontology Network (CEON) - Location Module"^^xsd:string ;
    vann:preferredNamespacePrefix "ceon-location"^^xsd:string ;
    vann:preferredNamespaceUri "http://w3id.org/CEON/ontoloy/location/"^^xsd:string ;
    odp:coversRequirements "Covers the following requirements from Onto-DESIDE D3.2: CE3-3, C3-2, C13-4, E2-12."^^xsd:string ;
    rdfs:comment "A core ODP of the CEON ontology network, defining aspects of the location concept."^^xsd:string ;
    rdfs:seeAlso <https://github.com/LiUSemWeb/CEON> ;
    owl:priorVersion 0.1 ;
    owl:versionIRI <http://w3id.org/CEON/ontology/location/0.2/> ;
    owl:versionInfo 0.2 .

location:hasCountryCode a owl:DatatypeProperty ;
    rdfs:label "has country code"^^xsd:string ;
    rdfs:comment "Represents the code of a country's name according to ISO 3166-1."^^xsd:string ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "ISO 3166-1 (Codes for the representation of names of countries and their subdivisions – Part 1: Country code)"^^xsd:string .

location:hasGlobalLocationNumber a owl:DatatypeProperty ;
    rdfs:label "has global location number"^^xsd:string ;
    rdfs:comment "The Global Location Number (GLN) is part of the GS1 systems of standards."^^xsd:string ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "https://www.gs1.org/standards/id-keys/gln"^^xsd:string .

<http://w3id.org/CEON/ontology/material/> a owl:Ontology ;
    dcterms:contributor "Eva Blomqvist"^^xsd:string,
        "Mikael Lindecrantz"^^xsd:string,
        "Robin Keskisärkkä"^^xsd:string ;
    dcterms:created "2025-03-20"^^xsd:date ;
    dcterms:creator "Huanyu Li"^^xsd:string ;
    dcterms:description "The Material module of CEON (Circular Economy Ontology Network)."^^xsd:string ;
    dcterms:issued "2025-06-30"^^xsd:date ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:string ;
    dcterms:publisher "Onto-DESIDE"^^xsd:string ;
    dcterms:title "Circular Economy Ontology Network (CEON) - Material Module"^^xsd:string ;
    vann:preferredNamespacePrefix "ceon-material"^^xsd:string ;
    vann:preferredNamespaceUri "http://w3id.org/CEON/ontology/material/"^^xsd:string ;
    odp:coversRequirements "In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.1: CVN-Resource-2, CVN-ResourceType-4, C3-3, E1-3, E2-4, E5-2, T1-1, T10-2."^^xsd:string,
        "In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.2: CE5-2, C3-3, E1-1, E1-3, E1-11, E1-13, E2-4, E3-2, E3-5, E5-2, E5-4, E5-5, T1-1, T9-2, T10-2, T10-4, T22-2."^^xsd:string ;
    rdfs:seeAlso <https://github.com/LiUSemWeb/CEON> ;
    owl:imports <http://w3id.org/CEON/ontology/resourceODP/0.5/> ;
    owl:priorVersion 0.3 ;
    owl:versionIRI <http://w3id.org/CEON/ontology/material/0.4/> ;
    owl:versionInfo 0.4 .

