<http://w3id.org/CEON/ontology/material/anonymousFormula> a owl:DatatypeProperty ;
    rdfs:label "anonymous formula"^^xsd:string ;
    rdfs:comment "anonymousFormula represents that a molecular entity has the anonymous formula in a string."^^xsd:string ;
    rdfs:seeAlso "https://w3id.org/mdo/structure/AnonymousFormula"^^xsd:string .

<http://w3id.org/CEON/ontology/material/descriptiveFormula> a owl:DatatypeProperty ;
    rdfs:label "descriptive formula"^^xsd:string ;
    rdfs:comment "descriptiveFormula represents that a molecular entity has the descriptive formula in a string."^^xsd:string ;
    rdfs:seeAlso "https://w3id.org/mdo/structure/DescriptiveFormula"^^xsd:string .

<http://w3id.org/CEON/ontology/material/hasMaterialComponent> a owl:ObjectProperty ;
    rdfs:label "has material component"^^xsd:string ;
    rdfs:comment "hasMaterialComponent intends to represent that a material can have a collection of components."^^xsd:string ;
    rdfs:domain <http://w3id.org/CEON/ontology/material/Material> ;
    rdfs:range <http://w3id.org/CEON/ontology/material/MaterialComponent> .

<http://w3id.org/CEON/ontology/material/hillFormula> a owl:DatatypeProperty ;
    rdfs:label "hill formula"^^xsd:string ;
    rdfs:comment "hillFormula represents that a composition has the hill formula in a string."^^xsd:string ;
    rdfs:seeAlso "https://w3id.org/mdo/structure/HillFormula"^^xsd:string .

<http://w3id.org/CEON/ontology/material/reducedChemicalFormula> a owl:DatatypeProperty ;
    rdfs:label "reduced chemical formula"^^xsd:string ;
    rdfs:comment "reducedChemicalFormula represents that a molecular entity has the reduced chemical formula in a string."^^xsd:string ;
    rdfs:seeAlso "https://w3id.org/mdo/structure/ReducedFormula"^^xsd:string .

<http://w3id.org/CEON/ontology/plan/> a owl:Ontology ;
    dcterms:contributor "Eva Blomqvist"^^xsd:string ;
    dcterms:created "2025-06-19"^^xsd:date ;
    dcterms:creator "Huanyu Li"^^xsd:string ;
    dcterms:description "The Plan module of CEON (Circular Economy Ontology Network)."^^xsd:string ;
    dcterms:issued "2025-06-30"^^xsd:date ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:string ;
    dcterms:publisher "Onto-DESIDE"^^xsd:string ;
    dcterms:title "Circular Economy Ontology Network (CEON) - Plan Module"^^xsd:string ;
    vann:preferredNamespacePrefix "ceon-plan"^^xsd:string ;
    vann:preferredNamespaceUri "https://w3id.org/CEON/ontology/plan/"^^xsd:string ;
    odp:coversRequirements "In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.1: T8-2."^^xsd:string,
