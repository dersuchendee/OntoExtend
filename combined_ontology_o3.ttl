<http://www.example.org/ontology> a owl:Ontology .

# ── Fragment 1: What materials does a fibre contain? ──

#################################################################
# Classes
#################################################################

# Material, MaterialComponent, and others are assumed to be defined in the material ontology.

:Fibre a owl:Class ;
    rdfs:label "Fibre" ;
    rdfs:comment "A fibrous material. # GENERATED" ;
    rdfs:subClassOf :Material ,
        [ a owl:Restriction ;
          owl:onProperty :hasMaterialComponent ;
          owl:someValuesFrom :MaterialComponent ;
          rdfs:comment "Restricts a fibre to contain at least one material component, which represents a material contained in the fibre. # GENERATED" 
        ] .

#################################################################
# Object Properties
#################################################################

# The property :hasMaterialComponent is defined in the material ontology with:
# Domain: Material
# Range: MaterialComponent
# rdfs:label "has material component"
# rdfs:comment "Relates a material to one of its components."

# ── Fragment 2: What are the properties of and data about that fibre? ──

#################################################################
# Class representing a fibre as a material; used in querying 
# data about the fibre’s properties and additional data.
#################################################################
:Fibre a owl:Class ;
    rdfs:subClassOf ns4:Material ;
    rdfs:label "Fibre" ;
    rdfs:comment "A type of material representing a fibre whose properties and associated data can be queried." ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ns4:descriptiveFormula ;
        owl:someValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :hasDataSheet ;
        owl:someValuesFrom ns3:DataSheet
    ] .

#################################################################
# GENERATED: Object property linking a fibre to its associated data sheet.
#################################################################
:hasDataSheet a owl:ObjectProperty ;
    rdfs:domain :Fibre ;
    rdfs:range ns3:DataSheet ;
    rdfs:label "has data sheet" ;
    rdfs:comment "Relates a fibre material to a data sheet that provides properties and other data about it." .

# ── Fragment 3: When were material content and/or properties of this fiber changed? ──

#################################################################
# Classes and Properties reused from statement and material ontologies
#################################################################

# Material ontology: Matter and Material
# MaterialComponent can be used to represent parts of a material.

# Statement ontology classes (selected for material content/properties change)
# These classes represent statements about recycled material content:
ns6:MFOfPreConsumerRecycledMaterialContentStatement a owl:Class ;
    rdfs:label "Mass Fraction Of Pre Consumer Recycled Material Content Statement" ;
    rdfs:comment "Statement about the mass fraction of pre-consumer recycled material content." .

ns6:MFOfPostConsumerRecycledMaterialContentStatement a owl:Class ;
    rdfs:label "Mass Fraction Of Post Consumer Recycled Material Content Statement" ;
    rdfs:comment "Statement about the mass fraction of post-consumer recycled material content." .

ns6:MFOfPreConsumerRecycledMaterialContentAvailabilityStatement a owl:Class ;
    rdfs:label "Mass Fraction Of Pre Consumer Recycled Material Content Availability Statement" ;
    rdfs:comment "Availability statement for the mass fraction of pre-consumer recycled material content." .

ns6:MFOfPostConsumerRecycledMaterialContentAvailabilityStatement a owl:Class ;
    rdfs:label "Mass Fraction Of Post Consumer Recycled Material Content Availability Statement" ;
    rdfs:comment "Availability statement for the mass fraction of post-consumer recycled material content." .

ns6:PostConsumerRecycledMaterialCompositionStatement a owl:Class ;
    rdfs:label "Post Consumer Recycled Material Composition Statement" ;
    rdfs:comment "Statement about the composition of post consumer recycled material." .

ns6:MFOfRecycledMaterialContentAvailabilityStatement a owl:Class ;
    rdfs:label "Mass Fraction Of Recycled Material Availability Statement" ;
    rdfs:comment "Availability statement for the mass fraction of recycled material." .

ns6:PostConsumerRecycledMaterialCompositionAvailabilityStatement a owl:Class ;
    rdfs:label "Post Consumer Recycled Material Composition Availability Statement" ;
    rdfs:comment "Availability statement for the post consumer recycled material composition." .

ns6:PreConsumerRecycledMaterialCompositionStatement a owl:Class ;
    rdfs:label "Pre Consumer Recycled Material Composition Statement" ;
    rdfs:comment "Statement about the composition of pre consumer recycled material." .

ns6:PreConsumerRecycledMaterialCompositionAvailabilityStatement a owl:Class ;
    rdfs:label "Pre Consumer Recycled Material Composition Availability Statement" ;
    rdfs:comment "Availability statement for the pre consumer recycled material composition." .

ns6:MFOfRenewableMaterialAvailabilityStatement a owl:Class ;
    rdfs:label "Mass Fraction Of Renewable Material Availability Statement" ;
    rdfs:comment "Availability statement about the mass fraction of renewable material." .

ns6:MFOfProductDesignedCleanlyRemovedFromProductAssemblyAvailabilityStatement a owl:Class ;
    rdfs:label "Mass Fraction Of Product Designed Cleanly Removed From Product Assembly Availability Statement" ;
    rdfs:comment "Availability statement for the mass fraction of product components cleanly removed from assembly." .

ns6:MassFractionOfRecycledMaterialStatement a owl:Class ;
    rdfs:label "Mass Fraction Of Recycled Material Statement" ;
    rdfs:comment "Statement about the mass fraction of recycled material." .

ns6:MFOfProductDesignedCleanlyRemovedFromProductAssemblyStatement a owl:Class ;
    rdfs:label "Mass Fraction Of Product Designed Cleanly Removed From Product Assembly Statement" ;
    rdfs:comment "Statement about the mass fraction of product components cleanly removed from assembly." .

ns6:SustainablyProducedRenewableMaterialStatement a owl:Class ;
    rdfs:label "Sustainably Produced Renewable Material Statement" ;
    rdfs:comment "Statement about sustainably produced renewable material." .

#################################################################
# New Classes and Properties for modeling fiber and its changes
#################################################################

:Fiber a owl:Class ;
    rdfs:subClassOf ns4:Material ;
    rdfs:label "Fiber" ;
    rdfs:comment "A fiber material, modeled as a subclass of Material, whose content and/or properties may change over time." .

# Define a union class for representing any statement that captures a change in material content and/or properties.
:MaterialChangeStatement a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :hasChangeTimestamp ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Material Change Statement" ;
    rdfs:comment "A statement capturing a change in the material content and/or properties of a material." ;
    owl:equivalentClass [ a owl:Class ;
        owl:unionOf ( 
            ns6:MFOfPreConsumerRecycledMaterialContentStatement
            ns6:MFOfPostConsumerRecycledMaterialContentStatement
            ns6:MFOfPreConsumerRecycledMaterialContentAvailabilityStatement
            ns6:MFOfPostConsumerRecycledMaterialContentAvailabilityStatement
            ns6:PostConsumerRecycledMaterialCompositionStatement
            ns6:MFOfRecycledMaterialContentAvailabilityStatement
            ns6:PostConsumerRecycledMaterialCompositionAvailabilityStatement
            ns6:PreConsumerRecycledMaterialCompositionStatement
            ns6:PreConsumerRecycledMaterialCompositionAvailabilityStatement
            ns6:MFOfRenewableMaterialAvailabilityStatement
            ns6:MFOfProductDesignedCleanlyRemovedFromProductAssemblyAvailabilityStatement
            ns6:MassFractionOfRecycledMaterialStatement
            ns6:MFOfProductDesignedCleanlyRemovedFromProductAssemblyStatement
            ns6:SustainablyProducedRenewableMaterialStatement
        )
    ] .

# Property linking a Fiber to statements that indicate changes in its material content and/or properties.
:hasChangeStatement a owl:ObjectProperty ;  # GENERATED
    rdfs:domain :Fiber ;
    rdfs:range :MaterialChangeStatement ;
    rdfs:label "has change statement" ;
    rdfs:comment "Relates a fiber to a statement which records a change in its material content and/or properties." .

# Property to record the timestamp when a change occurred.
:hasChangeTimestamp a owl:DatatypeProperty ;  # GENERATED
    rdfs:domain :MaterialChangeStatement ;
    rdfs:range xsd:dateTime ;
    rdfs:label "has change timestamp" ;
    rdfs:comment "Records the timestamp when the material content and/or properties change occurred." .
