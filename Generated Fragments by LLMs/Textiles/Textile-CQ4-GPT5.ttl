@prefix : <http://w3id.org/CEON/ontology/textile/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:TextileProductDesignedForPositiveImpact a owl:Class ; # GENERATED
    rdfs:label "Textile Product Designed for Positive Impact" ; # GENERATED
    rdfs:comment "A textile product that is designed for actively positive impacts, such as renewable content or recycling." ; # GENERATED
    rdfs:subClassOf :TextileProduct, # Reuse the existing TextileProduct class
        [ a owl:Restriction ;
            owl:onProperty :textileProductDesignForRecycling ; # Reuse the existing object property for recycling design
            owl:someValuesFrom :TextileProductRecycledContent ], # Reuse the existing class for recycled content
        [ a owl:Restriction ;
            owl:onProperty :hasTextileProductRenewableContentValue ; # Reuse the existing object property for renewable content
            owl:someValuesFrom :TextileProductRenewableContentValue ] . # Reuse the existing class for renewable content value