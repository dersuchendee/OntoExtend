@prefix : <http://w3id.org/CEON/ontology/textile/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:MaintainedOrRepairedBy a owl:ObjectProperty ;
    rdfs:label "maintained or repaired by" ;
    rdfs:comment "Indicates the person responsible for maintaining or repairing a textile product." ;
    rdfs:domain :TextileProduct ;
    rdfs:range :UntrainedPerson .

:UntrainedPerson a owl:Class ;
    rdfs:label "Untrained Person" ;
    rdfs:comment "A person not professionally trained for maintaining or repairing textile products." .

