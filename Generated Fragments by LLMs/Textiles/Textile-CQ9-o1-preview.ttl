@prefix : <http://w3id.org/CEON/ontology/textile/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasSparePartsAvailable a owl:ObjectProperty ;
    rdfs:label "has spare parts available" ;
    rdfs:comment "Indicates that a textile product has spare parts available." ;
    rdfs:domain :TextileProduct ;
    rdfs:range :SparePart .

:SparePart a owl:Class ;
    rdfs:label "Spare Part" ;
    rdfs:comment "A part that can be used as a replacement or addition for a textile product." .

