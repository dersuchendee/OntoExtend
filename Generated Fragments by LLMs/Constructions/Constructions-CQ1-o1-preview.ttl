@prefix : <http://w3id.org/CEON/demo/construction/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:FloorTile a owl:Class ; # GENERATED
    rdfs:label "Floor Tile" ;
    rdfs:comment "A product that represents floor tiles." .

:GoodCondition a owl:Class ; # GENERATED
    rdfs:subClassOf :Condition ;
    rdfs:label "Good Condition" ;
    rdfs:comment "Represents a good condition of a product." .

:MediumCondition a owl:Class ; # GENERATED
    rdfs:subClassOf :Condition ;
    rdfs:label "Medium Condition" ;
    rdfs:comment "Represents a medium condition of a product." .

:BadCondition a owl:Class ; # GENERATED
    rdfs:subClassOf :Condition ;
    rdfs:label "Bad Condition" ;
    rdfs:comment "Represents a bad condition of a product." .

:FloorTileCondition a owl:Class ; # GENERATED
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :hasCondition ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:unionOf ( :GoodCondition :MediumCondition :BadCondition )
        ]
    ] ;
    rdfs:label "Floor Tile Condition" ;
    rdfs:comment "A class representing the condition of a floor tile." .

:FloorTile rdfs:subClassOf :FloorTileCondition . # GENERATED