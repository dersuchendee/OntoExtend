#################################################################
#    Object Properties
#################################################################

###  http://qudt.org/schema/qudt/hasQuantityKind
qudt:hasQuantityKind rdf:type owl:ObjectProperty ;
                     rdfs:range qudt:QuantityKind ;
                     rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> ;
                     rdfs:label "has quantity kind"@en ,
                                "has quantity kind" .


###  http://qudt.org/schema/qudt/hasUnit
qudt:hasUnit rdf:type owl:ObjectProperty .


###  http://qudt.org/schema/qudt/quantityValue
qudt:quantityValue rdf:type owl:ObjectProperty ;
                   rdfs:range qudt:QuantityValue ;
                   rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> ;
                   rdfs:label "quantity value" .


###  http://w3id.org/CEON/ontology/actor/capabilityExtent
actor:capabilityExtent rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf actorODP:capabilityProperty ;
                       rdfs:domain actorODP:Capability ;
                       rdfs:comment "The extent of this capability, e.g. stating whether there are limist to the capability, such as a maximum amount or size of something." ;
                       rdfs:label "capability extent" .





###  http://w3id.org/CEON/ontology/actor/neededResourceRelation
actor:neededResourceRelation rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf actorODP:capabilityProperty ;
                             rdfs:domain actorODP:Capability ;
                             rdfs:comment "In order for an actor to have a capability, it needs to have certain resources, e.g. materials, infrastrucutre, know-how, information etc." ;
                             rdfs:label "needed resource relations" .





###  http://w3id.org/CEON/ontology/actorODP/basedOnCapability
actorODP:basedOnCapability rdf:type owl:ObjectProperty ;
                           rdfs:domain actorODP:CollaborationParticipation ;
                           rdfs:range actorODP:Capability ;
                           rdfs:comment "An actor participates in a collaboration based on that it has some capability that is useful for the collaboration." ;
                           rdfs:label "based on capability" .


###  http://w3id.org/CEON/ontology/actorODP/capabilityOf
actorODP:capabilityOf rdf:type owl:ObjectProperty ;
                      rdfs:domain actorODP:Capability ;
                      rdfs:range [ rdf:type owl:Class ;
                                   owl:unionOf ( actorODP:Actor
                                                 actorODP:Infrastructure
                                               )
                                 ] ;
                      rdfs:comment "Relates to the actor holding the capability." ;
                      rdfs:label "capability of" .


###  http://w3id.org/CEON/ontology/actorODP/capabilityProperty
actorODP:capabilityProperty rdf:type owl:ObjectProperty ;
                            rdfs:domain actorODP:Capability ;
                            rdfs:comment "Relates some properties to the capability, such as the parameters of it, or the needed resources." ;
                            rdfs:label "capability property" .


###  http://w3id.org/CEON/ontology/actorODP/participantRole
actorODP:participantRole rdf:type owl:ObjectProperty ;
                         rdfs:domain actorODP:Participation ;
                         rdfs:range actorODP:Role ;
                         rdfs:comment "Holds the value of the role of the participant in this participation relation." ;
                         rdfs:label "participant role" .


###  http://w3id.org/CEON/ontology/actorODP/participatingActor
actorODP:participatingActor rdf:type owl:ObjectProperty ;
                            rdfs:domain actorODP:Participation ;
                            rdfs:range actorODP:Actor ;
                            rdfs:comment "Holds the value of the actor involved in this participation relation." ;
                            rdfs:label "participating actor" .


###  http://w3id.org/CEON/ontology/actorODP/participatingInfrastructure
actorODP:participatingInfrastructure rdf:type owl:ObjectProperty ;
                                     rdfs:domain actorODP:Participation ;
                                     rdfs:range actorODP:Infrastructure ;
                                     rdfs:comment "Holds the value of the infrastructure involved in this participation relation." ;
                                     rdfs:label "participating infrastructure" .


###  http://w3id.org/CEON/ontology/actorODP/participatingObject
actorODP:participatingObject rdf:type owl:ObjectProperty ;
                             rdfs:domain actorODP:ResourceParticipation ;
                             rdfs:range resourceODP:Resource ;
                             rdfs:comment "Participating object in a resource participation. This is part of a resource participation that can be a directional relation, and the participating object is the end point of the relation." ;
                             rdfs:label "participating object" .


###  http://w3id.org/CEON/ontology/actorODP/participatingResource
actorODP:participatingResource rdf:type owl:ObjectProperty ;
                               rdfs:domain actorODP:ResourceRelation ;
                               rdfs:range resourceODP:Resource ;
                               rdfs:comment "The resource that this participation relation relates to, i.e. for which the actor holds the specified role." ;
                               rdfs:label "participating resource" .


###  http://w3id.org/CEON/ontology/actorODP/participatingSubject
actorODP:participatingSubject rdf:type owl:ObjectProperty ;
                              rdfs:domain actorODP:ResourceParticipation ;
                              rdfs:range resourceODP:Resource ;
                              rdfs:comment "Participating subject in a resource participation. This is part of a resource participation that can be a directional relation, and the participating subject is the starting point of the relation." ;
                              rdfs:label "participating subject" .


###  http://w3id.org/CEON/ontology/actorODP/participating_infrastructure
actorODP:participating_infrastructure rdf:type owl:ObjectProperty ;
                                      rdfs:domain actorODP:Participation ;
                                      rdfs:range actorODP:Infrastructure ;
                                      rdfs:comment "Holds the value of the infrastructure involved in this participation relation." ;
                                      rdfs:label "participating infrastructure" .


###  http://w3id.org/CEON/ontology/actorODP/participationIn
actorODP:participationIn rdf:type owl:ObjectProperty ;
                         rdfs:domain actorODP:CollaborationParticipation ;
                         rdfs:range [ rdf:type owl:Class ;
                                      owl:unionOf ( cvn:Collaboration
                                                    processODP:Process
                                                  )
                                    ] ;
                         rdfs:comment "The collaboration or process that this participation relates to." ;
                         rdfs:label "is a participation in" ,
                                    "participation in" .


###  http://w3id.org/CEON/ontology/cvn/aimsAtValue
cvn:aimsAtValue rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( cvn:CVN
                                            cvn:CVNBlueprint
                                          )
                            ] ;
                rdfs:range value:ValueProposition ;
                rdfs:comment "The value proposition that the planned abstract CVN configuration, or concrete network wants to achieve." ;
                rdfs:label "aims at value" .


###  http://w3id.org/CEON/ontology/cvn/composedOf
cvn:composedOf rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( cvn:CVN
                                           processODP:Process
                                         )
                           ] ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( cvn:CVN
                                          processODP:Process
                                        )
                          ] ;
               rdfs:comment "Both a CVN and a process can be composed of other CVNs or processes." ;
               rdfs:label "composed of" .


###  http://w3id.org/CEON/ontology/cvn/createsValue
cvn:createsValue rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( actorODP:Participation
                                             cvn:CVN
                                             processODP:Process
                                           )
                             ] ;
                 rdfs:range value:Value ;
                 rdfs:comment "Value creation can be captured at the actor level, i.e. value created by an actor's participation in a collaboration, or at the process or complete CVN level." ;
                 rdfs:label "creates value" .


###  http://w3id.org/CEON/ontology/cvn/implementsBlueprint
cvn:implementsBlueprint rdf:type owl:ObjectProperty ;
                        rdfs:domain cvn:CVN ;
                        rdfs:range cvn:CVNBlueprint ;
                        rdfs:comment "The blueprint (or plan) that this concrete CVN is an instance of." ;
                        rdfs:label "implements blueprint" .


###  http://w3id.org/CEON/ontology/cvn/implementsStrategy
cvn:implementsStrategy rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf cvn:relatedStrategy ;
                       rdfs:domain cvn:CVN ;
                       rdfs:range cvn:CircularStrategy ;
                       rdfs:comment "A strategy that is implemented by this CVN or CVN blueprint." ;
                       rdfs:label "implements strategy" .


###  http://w3id.org/CEON/ontology/cvn/plansToImplementStrategy
cvn:plansToImplementStrategy rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf cvn:relatedStrategy ;
                             rdfs:domain cvn:CVNBlueprint ;
                             rdfs:range cvn:CircularStrategy ;
                             rdfs:comment "A strategy that is planned to be implemented by this CVN or CVN blueprint." ;
                             rdfs:label "plans to implement strategy" .


###  http://w3id.org/CEON/ontology/cvn/relatedStrategy
cvn:relatedStrategy rdf:type owl:ObjectProperty ;
                    rdfs:comment "A strategy that is targeted by this CVN or CVN blueprint." ;
                    rdfs:label "related strategy" .


###  http://w3id.org/CEON/ontology/energy/hasAnergy
energy:hasAnergy rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf actorODP:participatingObject ;
                 rdfs:comment "hasAnergy represents that energy has part of anergy." ;
                 rdfs:label "has anergy" .


###  http://w3id.org/CEON/ontology/energy/hasConvertedEnergy
energy:hasConvertedEnergy rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf actorODP:participatingResource ;
                          rdfs:range [ rdf:type owl:Class ;
                                       owl:unionOf ( energy:NonRenewableEnergy
                                                     energy:RenewableEnergy
                                                   )
                                     ] ;
                          rdfs:comment "hasConvertedEnergy represents that an energy transformation process has its final energy." ;
                          rdfs:label "has converted energy" .


###  http://w3id.org/CEON/ontology/energy/hasEnergySource
energy:hasEnergySource rdf:type owl:ObjectProperty ;
                       rdfs:domain energy:Energy ;
                       rdfs:range energy:EnergySource ;
                       rdfs:comment "hasEnergySource represents that energy can have some energy sources." ;
                       rdfs:label "has energy source" .


###  http://w3id.org/CEON/ontology/energy/hasExergy
energy:hasExergy rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf actorODP:participatingObject ;
                 rdfs:comment "hasExergy represents that energy has part of exergy." ;
                 rdfs:label "has exergy" .


###  http://w3id.org/CEON/ontology/energy/hasOriginalEnergy
energy:hasOriginalEnergy rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf actorODP:participatingResource ;
                         rdfs:range [ rdf:type owl:Class ;
                                      owl:unionOf ( energy:NonRenewableEnergy
                                                    energy:RenewableEnergy
                                                  )
                                    ] ;
                         rdfs:comment "hasOriginalEnergy represents that an energy transformation process has its initial energy." ;
                         rdfs:label "has original energy" .


###  http://w3id.org/CEON/ontology/energy/participatingEnergy
energy:participatingEnergy rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf actorODP:participatingSubject ;
                           rdfs:comment "participatingEnergy represents the energy in an energy composition." ;
                           rdfs:label "participating energy" .


###  http://w3id.org/CEON/ontology/location/hasLocation
location:hasLocation rdf:type owl:ObjectProperty ;
                     rdfs:range location:Location ;
                     rdfs:comment "Represents the location of an actor or resource." ;
                     rdfs:label "has location" .


###  http://w3id.org/CEON/ontology/material/hasChemicalEntity
material:hasChemicalEntity rdf:type owl:ObjectProperty ;
                           rdfs:domain material:Material ;
                           rdfs:range material:ChemicalEntity ;
                           rdfs:comment "hasChemicalEntity intends to represent that a material can have a collection of chemical entities." ;
                           rdfs:label "has chemical entity" .


###  http://w3id.org/CEON/ontology/material/hasMaterialComponent
material:hasMaterialComponent rdf:type owl:ObjectProperty ;
                              rdfs:domain material:Material ;
                              rdfs:range material:MaterialComponent ;
                              rdfs:comment "hasMaterialComponent intends to represent that a material can have a collection of components." ;
                              rdfs:label "has material component" .


###  http://w3id.org/CEON/ontology/process/affectsObject
process:affectsObject rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf processODP:isSettingFor ;
                      rdfs:domain process:Transition ;
                      rdfs:comment "A certain transition may affect objects, e.g. material that changes its state from one situation to another." ;
                      rdfs:label "affects object" .


###  http://w3id.org/CEON/ontology/process/needsEnergy
process:needsEnergy rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf processODP:hasInput ;
                    rdfs:range energy:Energy ;
                    rdfs:comment "The energy needed to perform a certain process." ;
                    rdfs:label "needs energy" .


###  http://w3id.org/CEON/ontology/process/producesCO2
process:producesCO2 rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf processODP:hasOutput ;
                    rdfs:range process:CO2Emission ;
                    rdfs:comment "The CO2 released or produced by the process." ;
                    rdfs:label "produces CO2" .


###  http://w3id.org/CEON/ontology/process/resultingResource
process:resultingResource rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf processODP:hasOutput ;
                          rdfs:range resourceODP:Resource ;
                          rdfs:comment "The resource that is the output (product, i.e. what is produced) from a certain process." ;
                          rdfs:label "resulting resource" .





###  http://w3id.org/CEON/ontology/processODP/duringTime
processODP:duringTime rdf:type owl:ObjectProperty ;
                      rdfs:range processODP:TimeInterval ;
                      rdfs:comment "The time interval during which something, e.g. a process or event, takes place." ;
                      rdfs:label "during time" .


###  http://w3id.org/CEON/ontology/processODP/hasInput
processODP:hasInput rdf:type owl:ObjectProperty ;
                    rdfs:domain processODP:Process ;
                    rdfs:comment "The inputs to a process or event." ;
                    rdfs:label "has input" .


###  http://w3id.org/CEON/ontology/processODP/hasOutput
processODP:hasOutput rdf:type owl:ObjectProperty ;
                     rdfs:domain processODP:Process ;
                     rdfs:comment "The output of a process or event." ;
                     rdfs:label "has output" .


###  http://w3id.org/CEON/ontology/processODP/hasPart
processODP:hasPart rdf:type owl:ObjectProperty ,
                            owl:TransitiveProperty ;
                   rdfs:comment "A process or event can consist of several parts, which are sub-processes (e.g. steps) or events." ;
                   rdfs:label "has part" .


###  http://w3id.org/CEON/ontology/processODP/isSettingFor
processODP:isSettingFor rdf:type owl:ObjectProperty ;
                        rdfs:domain processODP:Situation ;
                        rdfs:comment "The thing(s) that this situation is the setting for, e.g. a resource that is in a certain state." ;
                        rdfs:label "is the setting for" .


###  http://w3id.org/CEON/ontology/processODP/occursAtLocation
processODP:occursAtLocation rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf processODP:isSettingFor ;
                            rdfs:range location:Location ;
                            rdfs:comment "The location in which something (e.g. an event or process) takes place, e.g. the factory location where something is manufactured." ;
                            rdfs:label "occurs at location" .


###  http://w3id.org/CEON/ontology/product/associatedWithMatter
product:associatedWithMatter rdf:type owl:ObjectProperty ;
                             rdfs:domain product:MatterComposition ;
                             rdfs:range resourceODP:Matter ;
                             rdfs:comment "associatedWithMatter intends to represent the matter to which a matter compopsition information regards to." ;
                             rdfs:label "associated with matter" .


###  http://w3id.org/CEON/ontology/product/associatedWithProductModel
product:associatedWithProductModel rdf:type owl:ObjectProperty ;
                                   rdfs:domain product:ProductComposition ;
                                   rdfs:range product:Product ;
                                   rdfs:comment "associatedWithProductModel intends to represent the product model to which a product compopsition information regards to." ;
                                   rdfs:label "associated with product model" .


###  http://w3id.org/CEON/ontology/product/associatedWithProductObject
product:associatedWithProductObject rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf owl:topObjectProperty ;
                                    rdfs:domain product:ProductObjectComposition ;
                                    rdfs:range product:Item ;
                                    rdfs:comment "associatedWithProductObject intends to represent the item (product object) to which a product object compopsition information regards to." ;
                                    rdfs:label "associated with product object" .


###  http://w3id.org/CEON/ontology/product/batchOfProduct
product:batchOfProduct rdf:type owl:ObjectProperty ;
                       rdfs:domain resourceODP:BatchOfObjects ;
                       rdfs:range product:Product ;
                       rdfs:comment "batchOfProduct intends to represent what is the model product of a batch of objects." ;
                       rdfs:label "batch of products" .


###  http://w3id.org/CEON/ontology/product/complianceWith
product:complianceWith rdf:type owl:ObjectProperty ;
                       rdfs:domain product:Compliance ;
                       rdfs:comment "Represents what the compliance is compliant with (e.g. a standard or regulation)." ;
                       rdfs:label "compliance with" .


###  http://w3id.org/CEON/ontology/product/compositionOf
product:compositionOf rdf:type owl:ObjectProperty ;
                      rdfs:domain product:Composition ;
                      rdfs:range [ rdf:type owl:Class ;
                                   owl:unionOf ( product:Item
                                                 product:Product
                                                 resourceODP:Matter
                                               )
                                 ] ;
                      rdfs:comment "Represents what the composition is a composition of (i.e., the product, the product object or matter that is broken down into its components)." ;
                      rdfs:label "composition of" .


###  http://w3id.org/CEON/ontology/product/hasAssemblyLocation
product:hasAssemblyLocation rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf location:hasLocation ;
                            rdfs:domain [ rdf:type owl:Class ;
                                          owl:unionOf ( product:Item
                                                        product:Product
                                                      )
                                        ] ;
                            rdfs:range product:AssemblyLocation ;
                            rdfs:comment "Used to represent the location of assembly of a product or product object (item)." ;
                            rdfs:label "has assembly location" .


###  http://w3id.org/CEON/ontology/product/hasCompliance
product:hasCompliance rdf:type owl:ObjectProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( actorODP:Actor
                                                  processODP:Process
                                                  product:Item
                                                  product:Product
                                                )
                                  ] ;
                      rdfs:range product:Compliance ;
                      rdfs:comment "Used to link something (e.g., product or process) to a compliance." ;
                      rdfs:label "has compliance" .


###  http://w3id.org/CEON/ontology/product/hasComposition
product:hasComposition rdf:type owl:ObjectProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( product:Product
                                                   resourceODP:PhysicalObject
                                                 )
                                   ] ;
                       rdfs:range product:Composition ;
                       rdfs:comment "hasComposition intends to represent that a product model or physical object can have compostition information." ;
                       rdfs:label "has composition" .


###  http://w3id.org/CEON/ontology/product/hasManufacturerLocation
product:hasManufacturerLocation rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf location:hasLocation ;
                                rdfs:domain [ rdf:type owl:Class ;
                                              owl:unionOf ( product:Item
                                                            product:Product
                                                          )
                                            ] ;
                                rdfs:range product:ManufactureLocation ;
                                rdfs:comment "Used to represent the location of manufacturer of a product or product object (item)." ;
                                rdfs:label "has manufacture location" .


###  http://w3id.org/CEON/ontology/product/hasOriginLocation
product:hasOriginLocation rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf location:hasLocation ;
                          rdfs:domain [ rdf:type owl:Class ;
                                        owl:unionOf ( product:Item
                                                      product:Product
                                                    )
                                      ] ;
                          rdfs:range product:OriginLocation ;
                          rdfs:comment "Used to represent the location of origin of a product or product object (item)." ;
                          rdfs:label "has origin location" .


###  http://w3id.org/CEON/ontology/product/hasProductComponent
product:hasProductComponent rdf:type owl:ObjectProperty ;
                            rdfs:domain product:Product ;
                            rdfs:range product:Product ;
                            rdfs:comment "hasProductComponent intends to represent that a product can have other product components." ;
                            rdfs:label "has product component" .


###  http://w3id.org/CEON/ontology/product/hasProductObjectComponent
product:hasProductObjectComponent rdf:type owl:ObjectProperty ;
                                  rdfs:domain product:Item ;
                                  rdfs:range product:Item ;
                                  rdfs:label "has product object component" .


###  http://w3id.org/CEON/ontology/product/modelledBy
product:modelledBy rdf:type owl:ObjectProperty ;
                   rdfs:domain product:Item ;
                   rdfs:range product:Product ;
                   rdfs:comment "modelledBy intends to represent that product objects follow particular product models." ;
                   rdfs:label "modelled by" .


###  http://w3id.org/CEON/ontology/quantity/hasDimension
quantity:hasDimension rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf qudt:quantityValue ;
                      rdfs:comment "hasDimension is used to describe a dimension of a product or product object." ;
                      rdfs:label "has dimension" .


###  http://w3id.org/CEON/ontology/quantity/hasDismantlingCost
quantity:hasDismantlingCost rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf quantity:hasProcessCost ;
                            rdfs:comment "The cost of dismantling, expressed as an amount of money with a currency unit." ;
                            rdfs:label "has dismantling cost" .


###  http://w3id.org/CEON/ontology/quantity/hasHeight
quantity:hasHeight rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf quantity:hasDimension ;
                   rdfs:comment "hasHeight is used to describe the height of a product or product object." ;
                   rdfs:label "has height" .


###  http://w3id.org/CEON/ontology/quantity/hasLength
quantity:hasLength rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf quantity:hasDimension ;
                   rdfs:comment "hasLength is used to describe the length of a product or product object." ;
                   rdfs:label "has length" .


###  http://w3id.org/CEON/ontology/quantity/hasMarketValue
quantity:hasMarketValue rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf qudt:quantityValue ;
                        rdfs:comment "The market value, expressed as an amount of money with a currency unit." ;
                        rdfs:label "has market value" .


###  http://w3id.org/CEON/ontology/quantity/hasMaximalValueIncludedOfInterval
quantity:hasMaximalValueIncludedOfInterval rdf:type owl:ObjectProperty ;
                                           rdfs:subPropertyOf qudt:quantityValue ;
                                           rdfs:domain quantity:QuantityInterval ;
                                           rdfs:range qudt:QuantityValue ;
                                           rdfs:comment "represents the maximum value (included) of an interval" ;
                                           rdfs:label "has maximal value included of interval" .


###  http://w3id.org/CEON/ontology/quantity/hasMaximalValueNotIncludedOfInterval
quantity:hasMaximalValueNotIncludedOfInterval rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf qudt:quantityValue ;
                                              rdfs:domain quantity:QuantityInterval ;
                                              rdfs:range qudt:QuantityValue ;
                                              rdfs:comment "represents the maximum value (not included) of an interval" ;
                                              rdfs:label "has maximal value not included of interval" .


###  http://w3id.org/CEON/ontology/quantity/hasMinimalValueIncludedOfInterval
quantity:hasMinimalValueIncludedOfInterval rdf:type owl:ObjectProperty ;
                                           rdfs:subPropertyOf qudt:quantityValue ;
                                           rdfs:domain quantity:QuantityInterval ;
                                           rdfs:range qudt:QuantityValue ;
                                           rdfs:comment "represents the minimal value (included) of an interval" ;
                                           rdfs:label "has minimal value included of interval" .


###  http://w3id.org/CEON/ontology/quantity/hasMinimalValueNotIncludedOfInterval
quantity:hasMinimalValueNotIncludedOfInterval rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf qudt:quantityValue ;
                                              rdfs:domain quantity:QuantityInterval ;
                                              rdfs:range qudt:QuantityValue ;
                                              rdfs:comment "represents the minimal value (not included) of an interval" ;
                                              rdfs:label "has minimal value not included of interval" .


###  http://w3id.org/CEON/ontology/quantity/hasPrice
quantity:hasPrice rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf qudt:quantityValue ;
                  rdfs:comment "represents that sth has a specific cost" ;
                  rdfs:label "has price" .


###  http://w3id.org/CEON/ontology/quantity/hasProcessCost
quantity:hasProcessCost rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf qudt:quantityValue ;
                        rdfs:comment "represents that a process can have a cost" ;
                        rdfs:label "has process cost" .


###  http://w3id.org/CEON/ontology/quantity/hasRecyclingCost
quantity:hasRecyclingCost rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf quantity:hasProcessCost ;
                          rdfs:comment "The cost of recycling, expressed as an amount of money with a currency unit." ;
                          rdfs:label "has recycling cost" .


###  http://w3id.org/CEON/ontology/quantity/hasRefurbishmentCost
quantity:hasRefurbishmentCost rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf quantity:hasProcessCost ;
                              rdfs:comment "The cost of refurbishment, expressed as an amount of money with a currency unit." ;
                              rdfs:label "has refurbishment cost" .


###  http://w3id.org/CEON/ontology/quantity/hasTestingCost
quantity:hasTestingCost rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf quantity:hasProcessCost ;
                        rdfs:comment "The cost of testing, expressed as an amount of money with a currency unit." ;
                        rdfs:label "has testing cost" .


###  http://w3id.org/CEON/ontology/quantity/hasThickness
quantity:hasThickness rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf quantity:hasDimension ;
                      rdfs:comment "hasThickness is used to describe the thickness of a product or product object." ;
                      rdfs:label "has thickness" .


###  http://w3id.org/CEON/ontology/quantity/hasTransportCost
quantity:hasTransportCost rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf quantity:hasProcessCost ;
                          rdfs:comment "The cost of transportation, expressed as an amount of money with a currency unit." ;
                          rdfs:label "has transport cost" .


###  http://w3id.org/CEON/ontology/quantity/hasVolume
quantity:hasVolume rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf qudt:quantityValue ;
                   rdfs:comment "represents the volume of an object" ;
                   rdfs:label "has volume" .


###  http://w3id.org/CEON/ontology/quantity/hasWeight
quantity:hasWeight rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf qudt:quantityValue ;
                   rdfs:comment "represents the weight of an object" ;
                   rdfs:label "has weight" .


###  http://w3id.org/CEON/ontology/quantity/hasWidth
quantity:hasWidth rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf quantity:hasDimension ;
                  rdfs:comment "hasWidth is used to describe the width of a product or product object." ;
                  rdfs:label "has width" .


###  http://w3id.org/CEON/ontology/quantity/objectValue
quantity:objectValue rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf qudt:hasQuantityKind ;
                     rdfs:comment "objectValue is analogous to qudt:numericalValue" ;
                     rdfs:label "object value" .


###  http://w3id.org/CEON/ontology/resourceODP/containsInformation
resourceODP:containsInformation rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf resourceODP:hasPart ;
                                rdfs:domain resourceODP:Information ;
                                rdfs:range resourceODP:Information ;
                                rdfs:comment "Indicating that some piece of information is contained in a larger collection of information, e.g. a data sheet contains a statement about a certain parameter of a product." ;
                                rdfs:label "contains information" .


###  http://w3id.org/CEON/ontology/resourceODP/hasBatch
resourceODP:hasBatch rdf:type owl:ObjectProperty ;
                     rdfs:domain resourceODP:SetOfObjects ;
                     rdfs:range resourceODP:BatchOfObjects ;
                     rdfs:comment "hasBatch intends to represent that a set of objects can be captured by a number of batches where each batch contains a number of physical objects." ;
                     rdfs:label "has batch" .


###  http://w3id.org/CEON/ontology/resourceODP/hasConstituent
resourceODP:hasConstituent rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf resourceODP:hasPart ;
                           rdfs:domain resourceODP:PhysicalObject ;
                           rdfs:range resourceODP:Constituent ;
                           rdfs:comment "hasConstitutent intends to represent that a physical object can have a collection of composing components." ;
                           rdfs:label "has constituent" .


###  http://w3id.org/CEON/ontology/resourceODP/hasMatter
resourceODP:hasMatter rdf:type owl:ObjectProperty ;
                      rdfs:domain resourceODP:PhysicalObject ;
                      rdfs:range resourceODP:Matter ;
                      rdfs:comment "hasMatter intends to represent that a physical object can have a collection of matter." ;
                      rdfs:label "has matter" .


###  http://w3id.org/CEON/ontology/resourceODP/hasPart
resourceODP:hasPart rdf:type owl:ObjectProperty ,
                             owl:TransitiveProperty ;
                    rdfs:comment "Indicating that something is part of or is contained by something else." ;
                    rdfs:label "has part" .


###  http://w3id.org/CEON/ontology/resourceODP/hasPhysicalObject
resourceODP:hasPhysicalObject rdf:type owl:ObjectProperty ;
                              rdfs:domain [ rdf:type owl:Class ;
                                            owl:unionOf ( resourceODP:BatchOfObjects
                                                          resourceODP:SetOfObjects
                                                        )
                                          ] ;
                              rdfs:range resourceODP:PhysicalObject ;
                              rdfs:comment "hasPhysicalObject intends to represent that a batch of objects or a set of objects can have composing components of physical objects." ;
                              rdfs:label "has physical object" .


###  http://w3id.org/CEON/ontology/resourceODP/hasResourceCondition
resourceODP:hasResourceCondition rdf:type owl:ObjectProperty ;
                                 rdfs:domain resourceODP:Resource ;
                                 rdfs:range resourceODP:ResourceCondition ;
                                 rdfs:comment "A resource can has specifc conditions." ;
                                 rdfs:label "has resource condition" .


###  http://w3id.org/CEON/ontology/resourceODP/hasResourceLocation
resourceODP:hasResourceLocation rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf location:hasLocation ;
                                rdfs:domain resourceODP:Resource ;
                                rdfs:range location:Location ;
                                rdfs:comment "Defines the location of a resource." ;
                                rdfs:label "has resource location" .


###  http://w3id.org/CEON/ontology/resourceODP/hasResourceProperty
resourceODP:hasResourceProperty rdf:type owl:ObjectProperty ;
                                rdfs:domain resourceODP:Resource ;
                                rdfs:range resourceODP:ResourceProperty ;
                                rdfs:comment "A resource can has specifc properties." ;
                                rdfs:label "has resource property" .


###  http://w3id.org/CEON/ontology/resourceODP/hasResourceQuality
resourceODP:hasResourceQuality rdf:type owl:ObjectProperty ;
                               rdfs:domain resourceODP:Resource ;
                               rdfs:range resourceODP:ResourceQuality ;
                               rdfs:comment "A resource can has specifc qualities." ;
                               rdfs:label "has resource quality" .


###  http://w3id.org/CEON/ontology/resourceODP/isAbout
resourceODP:isAbout rdf:type owl:ObjectProperty ;
                    rdfs:domain resourceODP:Information ;
                    rdfs:comment "Connecting the information to the object (physical, virtual, imaginary) that the information is about." ;
                    rdfs:label "is about" .


###  http://w3id.org/CEON/ontology/resourceODP/isRealizationOf
resourceODP:isRealizationOf rdf:type owl:ObjectProperty ;
                            rdfs:range resourceODP:Information ;
                            rdfs:comment "Relates a thing, e.g. a digital object, or a physical object, to the information it is a realization of. C.f. a physical book that is the realization of a novel, or a pdf or Excel-file that is a realization of a certain data sheet." ;
                            rdfs:label "is realization of" .


###  http://w3id.org/CEON/ontology/statement/hasAvailability
statement:hasAvailability rdf:type owl:ObjectProperty ;
                          rdfs:range statement:Availability ;
                          rdfs:comment "hasAvailability represents the abailability of some resource or information." ;
                          rdfs:label "has availability" .


###  http://w3id.org/CEON/ontology/statement/hasChemicalSubstanceThresholdUsedByManufacturer
statement:hasChemicalSubstanceThresholdUsedByManufacturer rdf:type owl:ObjectProperty ;
                                                          rdfs:subPropertyOf statement:hasQuantityInterval ;
                                                          rdfs:domain statement:ProductCompositionStatement ;
                                                          rdfs:range <http://w3id.org/CEON/ontology/quantity#QuantityInterval> ;
                                                          rdfs:label "has chemical substance threshold used by manufacturer" .


###  http://w3id.org/CEON/ontology/statement/hasFractionOfRenewableEnergyOutOfTheTotalProductionEnergyMix
statement:hasFractionOfRenewableEnergyOutOfTheTotalProductionEnergyMix rdf:type owl:ObjectProperty ;
