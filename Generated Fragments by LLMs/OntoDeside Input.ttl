                                                                              owl:hasValue <http://w3id.org/CEON/ontology/statement/50gt-75le>
                                                                            ]
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty statement:hasVolumeFractionOfReductionOfDirectWaterConsumptionUsedInProduction ;
                                                                              owl:hasValue <http://w3id.org/CEON/ontology/statement/75gt-95le>
                                                                            ]
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty statement:hasVolumeFractionOfReductionOfDirectWaterConsumptionUsedInProduction ;
                                                                              owl:hasValue <http://w3id.org/CEON/ontology/statement/95gt-99le>
                                                                            ]
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty statement:hasVolumeFractionOfReductionOfDirectWaterConsumptionUsedInProduction ;
                                                                              owl:hasValue <http://w3id.org/CEON/ontology/statement/99gt-100le>
                                                                            ]
                                                                          )
                                                            ] ;
                                            statement:PCDSmapping "4.2.1.10, 4.2.1.11, 4.2.1.12, 4.2.1.13, 4.2.1.14, 4.2.1.15, 4.2.1.16, 4.2.1.17" ;
                                            rdfs:label "Volume Fraction Of Reduction Direct Water Statement" .


###  http://w3id.org/CEON/ontology/statement/VFOfReusedRecirculatedWaterAvailabilityStatement
statement:VFOfReusedRecirculatedWaterAvailabilityStatement rdf:type owl:Class ;
                                                           rdfs:subClassOf statement:WaterReuseOrRecirculationStatement ;
                                                           statement:PCDSmapping "4.2.1.09" ;
                                                           rdfs:label "Volume Fraction Of Reused Recirculated Water Availability Statement" .


###  http://w3id.org/CEON/ontology/statement/VFOfReusedRecirculatedWaterStatement
statement:VFOfReusedRecirculatedWaterStatement rdf:type owl:Class ;
                                               rdfs:subClassOf statement:WaterReuseOrRecirculationStatement ,
                                                               [ rdf:type owl:Class ;
                                                                 owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty statement:hasVolumeFractionOfReusedOrRecirculatedWaterUsedInProduction ;
                                                                                 owl:hasValue <http://w3id.org/CEON/ontology/statement/0ge-0le>
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty statement:hasVolumeFractionOfReusedOrRecirculatedWaterUsedInProduction ;
                                                                                 owl:hasValue <http://w3id.org/CEON/ontology/statement/0gt-10le>
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty statement:hasVolumeFractionOfReusedOrRecirculatedWaterUsedInProduction ;
                                                                                 owl:hasValue <http://w3id.org/CEON/ontology/statement/10gt-25le>
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty statement:hasVolumeFractionOfReusedOrRecirculatedWaterUsedInProduction ;
                                                                                 owl:hasValue <http://w3id.org/CEON/ontology/statement/25gt-50le>
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty statement:hasVolumeFractionOfReusedOrRecirculatedWaterUsedInProduction ;
                                                                                 owl:hasValue <http://w3id.org/CEON/ontology/statement/50gt-75le>
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty statement:hasVolumeFractionOfReusedOrRecirculatedWaterUsedInProduction ;
                                                                                 owl:hasValue <http://w3id.org/CEON/ontology/statement/75gt-95le>
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty statement:hasVolumeFractionOfReusedOrRecirculatedWaterUsedInProduction ;
                                                                                 owl:hasValue <http://w3id.org/CEON/ontology/statement/95gt-99le>
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty statement:hasVolumeFractionOfReusedOrRecirculatedWaterUsedInProduction ;
                                                                                 owl:hasValue <http://w3id.org/CEON/ontology/statement/99gt-100le>
                                                                               ]
                                                                             )
                                                               ] ;
                                               statement:PCDSmapping "4.2.1.01, 4.2.1.02, 4.2.1.03, 4.2.1.04, 4.2.1.05, 4.2.1.06, 4.2.1.07, 4.2.1.08" ;
                                               rdfs:label "Volume Fraction Of Reused Recirculated Water Statement" .


###  http://w3id.org/CEON/ontology/statement/Validation
statement:Validation rdf:type owl:Class ;
                     rdfs:label "Validation" .


###  http://w3id.org/CEON/ontology/statement/WaterReuseOrRecirculationStatement
statement:WaterReuseOrRecirculationStatement rdf:type owl:Class ;
                                             rdfs:subClassOf statement:PCDSStatement ;
                                             rdfs:comment "Water Reuse or Recirculation Statement in PCDS." ;
                                             rdfs:label "Water Reuse Or Recirculation Statement" .


###  http://w3id.org/CEON/ontology/value/EconomicValue
value:EconomicValue rdf:type owl:Class ;
                    owl:equivalentClass value:UseValue ;
                    rdfs:subClassOf value:Value ;
                    rdfs:comment "Use/Economics value represents how a thing (e.g., a product or service) match some goals or needs of an actor under some circumstances." ;
                    rdfs:label "Economic Value" .


###  http://w3id.org/CEON/ontology/value/EnvironmentalValue
value:EnvironmentalValue rdf:type owl:Class ;
                         rdfs:subClassOf value:Value ;
                         rdfs:comment "Environmental value represents how a thing (e.g., a product or service) match some environmental goals or needs of an actor under some circumstances." ;
                         rdfs:label "Environmental Value" .


###  http://w3id.org/CEON/ontology/value/ExchangeValue
value:ExchangeValue rdf:type owl:Class ;
                    rdfs:subClassOf value:Value ;
                    rdfs:comment "Exchange value represents the worth of a product, resource, service in a exchange setting, i.e., a product, resource, service is traded or sold." ;
                    rdfs:label "Exchange Value" .


###  http://w3id.org/CEON/ontology/value/SocialValue
value:SocialValue rdf:type owl:Class ;
                  rdfs:subClassOf value:Value ;
                  rdfs:comment "Social value represents how a thing (e.g., a product or service) match some social goals or needs of an actor under some circumstances." ;
                  rdfs:label "Social Value" .


###  http://w3id.org/CEON/ontology/value/UseValue
value:UseValue rdf:type owl:Class ;
               rdfs:subClassOf value:Value ;
               rdfs:comment "Use/Economics value represents how a thing (e.g., a product or service) match some goals or needs of an actor under some circumstances." ;
               rdfs:label "Use Value" .


###  http://w3id.org/CEON/ontology/value/Value
value:Value rdf:type owl:Class ;
            rdfs:comment "Gain(s) or benefit(s) from satisfying needs and expectations,	in relation to the use	and conservation of resources. EXAMPLE: Revenue, savings, productivity, sustainability, satisfaction, empowerment, engagement, experience, public health, trust. Value is relative to, and determined by the perception of, those interested party(ies) able to capture it. Value can be financial or non-financial, e.g. social, environmental, other gains or benefits. Value is dynamic over time."@en ;
            rdfs:isDefinedBy "ISO 59004:2024 - 3.1.7 value" ;
            rdfs:label "Value" .


###  http://w3id.org/CEON/ontology/value/ValueParticipation
value:ValueParticipation rdf:type owl:Class ;
                         rdfs:subClassOf actorODP:Participation ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty value:hasAssociatedValue ;
                                           owl:someValuesFrom value:Value
                                         ] ;
                         rdfs:comment "A participation that may create/destory/miss value." ;
                         rdfs:label "Value Participation" .


###  http://w3id.org/CEON/ontology/value/ValueParticipationRole
value:ValueParticipationRole rdf:type owl:Class ;
                             rdfs:subClassOf actorODP:Role ;
                             rdfs:comment "A role that a value participant can take." ;
                             rdfs:label "Value Participation Role" .


###  http://w3id.org/CEON/ontology/value/ValuePerception
value:ValuePerception rdf:type owl:Class ;
                      rdfs:comment "Value perception of an actor determines specifc values." ;
                      rdfs:label "Value Perception" .


###  http://w3id.org/CEON/ontology/value/ValueProposition
value:ValueProposition rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty value:hasAimedValue ;
                                         owl:someValuesFrom value:Value
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty value:targettingActor ;
                                         owl:someValuesFrom actorODP:Actor
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty value:targettingValueParticipation ;
                                         owl:someValuesFrom value:ValueParticipation
                                       ] ;
                       rdfs:comment "Proposed or intended value outcome of some process, action or collaboration." ;
                       rdfs:label "Value Proposition" .


###  http://www.opengis.net/ont/geosparql#Geometry
<http://www.opengis.net/ont/geosparql#Geometry> rdf:type owl:Class ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A coherent set of direct positions in space. The positions are held within a Spatial Reference System (SRS)."@en ;
                                                <http://www.w3.org/2004/02/skos/core#prefLabel> "Geometry"@en .


