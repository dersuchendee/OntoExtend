                                                                       rdfs:range <http://w3id.org/CEON/ontology/quantity#QuantityInterval> ;
                                                                       rdfs:label "has fraction of renewable energy out of the total production energy mix" .


###  http://w3id.org/CEON/ontology/statement/hasMassFractionForDemounting
statement:hasMassFractionForDemounting rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf statement:hasQuantityInterval ;
                                       rdfs:domain statement:DemountingStatement ;
                                       rdfs:range <http://w3id.org/CEON/ontology/quantity#QuantityInterval> ;
                                       rdfs:label "has mass fraction for demounting" .


###  http://w3id.org/CEON/ontology/statement/hasMassFractionForDisassembly
statement:hasMassFractionForDisassembly rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf statement:hasQuantityInterval ;
                                        rdfs:domain statement:DisassemblyStatement ;
                                        rdfs:range <http://w3id.org/CEON/ontology/quantity#QuantityInterval> ;
                                        rdfs:label "has mass fraction for disassembly" .


###  http://w3id.org/CEON/ontology/statement/hasMassFractionOfAllDisclosedChemicalSubstance
statement:hasMassFractionOfAllDisclosedChemicalSubstance rdf:type owl:ObjectProperty ;
                                                         rdfs:subPropertyOf statement:hasQuantityInterval ;
                                                         rdfs:domain statement:ProductCompositionStatement ;
                                                         rdfs:range <http://w3id.org/CEON/ontology/quantity#QuantityInterval> ;
                                                         rdfs:label "has mass fraction of all disclosed chemical substance" .


###  http://w3id.org/CEON/ontology/statement/hasMassFractionOfDismantableComponentsForReuseAndRecycle
statement:hasMassFractionOfDismantableComponentsForReuseAndRecycle rdf:type owl:ObjectProperty ;
