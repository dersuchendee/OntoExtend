<http://www.w3.org/2003/01/geo/wgs84_pos#long> rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://example.com/Volume
<http://example.com/Volume> rdf:type owl:Class .


###  http://example.com/Weight
<http://example.com/Weight> rdf:type owl:Class .


###  http://qudt.org/schema/qudt/Quantity
qudt:Quantity rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty qudt:hasQuantityKind ;
                                owl:allValuesFrom qudt:QuantityKind
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty qudt:quantityValue ;
                                owl:allValuesFrom qudt:QuantityValue
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty qudt:hasQuantityKind ;
                                owl:minCardinality "0"^^xsd:nonNegativeInteger
                              ] ;
              rdfs:comment """<p class=\"lm-para\">A <b>quantity</b> is the measurement of an observable property of a particular object, event, or physical system. A quantity is always associated with the context of measurement (i.e. the thing measured, the measured value, the accuracy of measurement, etc.) whereas the underlying <b>quantity kind</b> is independent of any particular measurement. Thus, length is a quantity kind while the height of a rocket is a specific quantity of length; its magnitude that may be expressed in meters, feet, inches, etc. Examples of physical quantities include physical constants, such as the speed of light in a vacuum, Planck's constant, the electric permittivity of free space, and the fine structure constant. </p>

<p class=\"lm-para\">In other words, quantities are quantifiable aspects of the world, such as the duration of a movie, the distance between two points, velocity of a car, the pressure of the atmosphere, and a person's weight; and units are used to describe their numerical measure. 

</p><p class=\"lm-para\">Many <b>quantity kinds</b> are related to each other by various physical laws, and as a result, the associated units of some quantity kinds can be expressed as products (or ratios) of powers of other quantity kinds (e.g., momentum is mass times velocity and velocity is defined as distance divided by time). In this way, some quantities can be calculated from other measured quantities using their associations to the quantity kinds in these expressions. These quantity kind relationships are also discussed in dimensional analysis. Those that cannot be so expressed can be regarded as &quot;fundamental&quot; in this sense.</p>
<p class=\"lm-para\">A quantity is distinguished from a &quot;quantity kind&quot; in that the former carries a value and the latter is a type specifier.</p>"""^^rdf:HTML ;
              rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> ;
              rdfs:label "Quantity" .


###  http://qudt.org/schema/qudt/QuantityKind
qudt:QuantityKind rdf:type owl:Class ;
                  <http://purl.org/dc/elements/1.1/description> "A Quantity Kind is any observable property that can be  measured and quantified numerically. Familiar examples include physical properties such as length, mass, time, force, energy, power, electric charge, etc. Less familiar examples include currency, interest rate, price to earning ratio, and information capacity." ;
                  rdfs:comment "A <b>Quantity Kind</b> is any observable property that can be  measured and quantified numerically. Familiar examples include physical properties such as length, mass, time, force, energy, power, electric charge, etc. Less familiar examples include currency, interest rate, price to earning ratio, and information capacity."^^rdf:HTML ;
                  rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> ;
                  rdfs:label "Quantity Kind" .


###  http://qudt.org/schema/qudt/QuantityValue
qudt:QuantityValue rdf:type owl:Class ;
                   <http://purl.org/dc/elements/1.1/description> "A Quantity Value expresses the magnitude and kind of a quantity and is given by the product of a numerical value n and a unit of measure U. The number multiplying the unit is referred to as the numerical value of the quantity expressed in that unit." ;
                   rdfs:label "Quantity Value" .


###  http://qudt.org/schema/qudt/Unit
qudt:Unit rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty qudt:hasQuantityKind ;
                            owl:allValuesFrom qudt:QuantityKind
                          ] ;
          terms:description "A unit of measure, or unit, is a particular quantity value that has been chosen as a scale for measuring other quantities the same kind (more generally of equivalent dimension). For example, the meter is a quantity of length that has been rigorously defined and standardized by the BIPM (International Board of Weights and Measures). Any measurement of the length can be expressed as a number multiplied by the unit meter. More formally, the value of a physical quantity Q with respect to a unit (U) is expressed as the scalar multiple of a real number (n) and U, as  \\(Q = nU\\)."^^qudt:LatexString ;
          rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> ;
          rdfs:label "Unit" .


###  http://w3id.org/CEON/ontology/actor/ActorCVNRole
actor:ActorCVNRole rdf:type owl:Class ;
                   rdfs:subClassOf actor:ActorCollaborationRole ;
                   rdfs:comment "The role(s) of an actor in a Circular Value Network, which is a specific type of collaboration." ;
                   rdfs:label "Actor Circular Value Network role" .


###  http://w3id.org/CEON/ontology/actor/ActorCollaborationRole
actor:ActorCollaborationRole rdf:type owl:Class ;
                             rdfs:subClassOf actorODP:Role ;
                             rdfs:comment "The roles of an actor involved in a collaboration." ;
                             rdfs:label "Actor collaboration role" .


###  http://w3id.org/CEON/ontology/actor/ActorProcessRole
actor:ActorProcessRole rdf:type owl:Class ;
                       rdfs:subClassOf actor:ActorCollaborationRole ;
                       rdfs:comment "The role(s) of an actor involved in a process." ;
                       rdfs:label "Actor process role" .


###  http://w3id.org/CEON/ontology/actor/ActorResourceRole
actor:ActorResourceRole rdf:type owl:Class ;
                        rdfs:subClassOf actorODP:Role ;
                        rdfs:comment "The role(s) of an actor in relation to a resource." ;
                        rdfs:label "Actor resource role" .


###  http://w3id.org/CEON/ontology/actor/BuyingResource
actor:BuyingResource rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty actorODP:participantRole ;
                                                                  owl:hasValue actor:buyer
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf actorODP:ResourceRelation ;
                     rdfs:comment "The relation where the role of the actor is the buyer of a certain resource." ;
                     rdfs:label "Buying resource" .


###  http://w3id.org/CEON/ontology/actor/CVNParticipation
actor:CVNParticipation rdf:type owl:Class ;
                       rdfs:subClassOf actorODP:CollaborationParticipation ,
                                       [ owl:intersectionOf ( actorODP:CollaborationParticipation
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty actorODP:participantRole ;
                                                                owl:someValuesFrom actor:ActorCVNRole
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty actorODP:participatingActor ;
                                                                owl:someValuesFrom actorODP:Actor
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty actorODP:participationIn ;
                                                                owl:someValuesFrom cvn:CVN
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                       rdfs:comment "A participation-relation, that represents the participation of an actor in a CVN with a certain role. For instance, a specific company playing the role of recycler in a certain flow of a CVN. The participation may also be related to a certain time (or time interval)." ;
                       rdfs:label "Circular Value Network Participation" .


###  http://w3id.org/CEON/ontology/actor/ConsumingResource
actor:ConsumingResource rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty actorODP:participantRole ;
                                                                     owl:hasValue actor:consumer
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf actorODP:ResourceRelation ;
                        rdfs:comment "The relation where the role of the actor is the consumer of a certain resource." ;
                        rdfs:label "Consuming resource" .


###  http://w3id.org/CEON/ontology/actor/DismantlingResource
actor:DismantlingResource rdf:type owl:Class ;
                          owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty actorODP:participantRole ;
                                                                       owl:hasValue actor:dismantler
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ] ;
                          rdfs:subClassOf actorODP:ResourceRelation ;
                          rdfs:comment "The relation where the role of the actor is the dismantler of a certain resource." ;
                          rdfs:label "Dismantling resource" .


###  http://w3id.org/CEON/ontology/actor/IssuingResource
actor:IssuingResource rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty actorODP:participantRole ;
                                                                   owl:hasValue actor:issuer
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf actorODP:ResourceRelation ;
                      rdfs:comment "The relation where the role of the actor is the issuer of a certain resource." ;
                      rdfs:label "Issuing resource" .


###  http://w3id.org/CEON/ontology/actor/ManufacturingResource
actor:ManufacturingResource rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty actorODP:participantRole ;
                                                                         owl:hasValue actor:manufacturer
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ;
                            rdfs:subClassOf actorODP:ResourceRelation ;
                            rdfs:comment "The relation where the role of the actor is the manufacturer of a certain resource." ;
                            rdfs:label "Manufacturing resource" .





###  http://w3id.org/CEON/ontology/actor/OwningResource
actor:OwningResource rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty actorODP:participantRole ;
                                                                  owl:hasValue actor:owner
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf actorODP:ResourceRelation ;
                     rdfs:comment "The relation where the role of the actor is the owner of a certain resource." ;
                     rdfs:label "Owning resource" .




###  http://w3id.org/CEON/ontology/actor/ProcessParticipation
actor:ProcessParticipation rdf:type owl:Class ;
                           rdfs:subClassOf actorODP:CollaborationParticipation ,
                                           [ owl:intersectionOf ( actorODP:CollaborationParticipation
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty actorODP:participantRole ;
                                                                    owl:someValuesFrom actor:ActorProcessRole
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty actorODP:participatingActor ;
                                                                    owl:someValuesFrom actorODP:Actor
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty actorODP:participationIn ;
                                                                    owl:someValuesFrom processODP:Process
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                           rdfs:comment "Participation of a certain actor in a certain process, with a certain role. For instance, a certain department of a recycling company having the role of quality controllant, or material sorter, in a certain recycling process. The participation may also be given a time, e.g. a start and end time." ;
                           rdfs:label "Process Participation" .


###  http://w3id.org/CEON/ontology/actor/ProducingResource
actor:ProducingResource rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty actorODP:participantRole ;
                                                                     owl:hasValue actor:producer
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf actorODP:ResourceRelation ;
                        rdfs:comment "The relation where the role of the actor is the producer of a certain resource." ;
                        rdfs:label "Producing resource" .


###  http://w3id.org/CEON/ontology/actor/ProvidingResource
actor:ProvidingResource rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty actorODP:participantRole ;
                                                                     owl:hasValue actor:provider
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf actorODP:ResourceRelation ;
                        rdfs:comment "The relation where the role of the actor is the provider of a certain resource." ;
                        rdfs:label "Providing resource" .


###  http://w3id.org/CEON/ontology/actor/RecyclingResource
actor:RecyclingResource rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty actorODP:participantRole ;
                                                                     owl:hasValue actor:recycler
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf actorODP:ResourceRelation ;
                        rdfs:comment "The relation where the role of the actor is the recycler of a certain resource." ;
                        rdfs:label "Recycling resource" .


###  http://w3id.org/CEON/ontology/actor/RepairingResource
actor:RepairingResource rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty actorODP:participantRole ;
                                                                     owl:hasValue actor:repairer
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf actorODP:ResourceRelation ;
                        rdfs:comment "The relation where the role of the actor is the repairer of a certain resource." ;
                        rdfs:label "Repairing resource" .


###  http://w3id.org/CEON/ontology/actor/ResellingResource
actor:ResellingResource rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty actorODP:participantRole ;
                                                                     owl:hasValue actor:reseller
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf actorODP:ResourceRelation ;
                        rdfs:comment "The relation where the role of the actor is the reseller of a certain resource." ;
                        rdfs:label "Reselling resource" .


###  http://w3id.org/CEON/ontology/actor/SellingResource
actor:SellingResource rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty actorODP:participantRole ;
                                                                   owl:hasValue actor:seller
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf actorODP:ResourceRelation ;
                      rdfs:comment "The relation where the role of the actor is the seller of a certain resource." ;
                      rdfs:label "Selling resource" .



###  http://w3id.org/CEON/ontology/actor/SupplyingResource
actor:SupplyingResource rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty actorODP:participantRole ;
                                                                     owl:hasValue actor:supplier
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf actorODP:ResourceRelation ;
                        rdfs:comment "The relation where the role of the actor is the supplier of a certain resource." ;
                        rdfs:label "Supplying resource" .


###  http://w3id.org/CEON/ontology/actor/TakingBackResource
actor:TakingBackResource rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty actorODP:participantRole ;
                                                                      owl:hasValue actor:collector
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf actorODP:ResourceRelation ;
                         rdfs:label "Taking back resource" ,
                                    "The relation where the role of the actor is the collector of a certain resource." .


###  http://w3id.org/CEON/ontology/actor/UpdatingResource
actor:UpdatingResource rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty actorODP:participantRole ;
                                                                    owl:hasValue actor:updater
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf actorODP:ResourceRelation ;
                       rdfs:comment "The relation where the role of the actor is the updater of a certain resource." ;
                       rdfs:label "Updating resource" .


###  http://w3id.org/CEON/ontology/actor/UsingResource
actor:UsingResource rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty actorODP:participantRole ;
                                                                 owl:hasValue actor:user
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf actorODP:ResourceRelation ;
                    rdfs:comment "The relation where the role of the actor is the user of a certain resource." ;
                    rdfs:label "Using resource" .


###  http://w3id.org/CEON/ontology/actor/ViewingResource
actor:ViewingResource rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( actorODP:ResourceRelation
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty actorODP:participantRole ;
                                                                   owl:hasValue actor:viewer
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf actorODP:ResourceRelation ;
                      rdfs:comment "The relation where the role of the actor is the viewer of a certain resource." ;
                      rdfs:label "Viewing resource" .


###  http://w3id.org/CEON/ontology/actorODP/Actor
actorODP:Actor rdf:type owl:Class ;
               rdfs:comment "" ;
               rdfs:label "Actor" .





###  http://w3id.org/CEON/ontology/actorODP/Capability
actorODP:Capability rdf:type owl:Class ;
                    rdfs:comment "Something that the actor is capable of doing, e.g. perfomring a certain role in a process, based on some properties, such as access to infrastructure, resources and know-how." ;
                    rdfs:label "Capability" .


###  http://w3id.org/CEON/ontology/actorODP/CollaborationParticipation
actorODP:CollaborationParticipation rdf:type owl:Class ;
                                    rdfs:subClassOf actorODP:Participation ;
                                    rdfs:comment "The relation involving the role of a certain actor with respect to a value network or a process in such a network, e.g. an organisation (actor) acting as the recycler (role) in a glass recycling value netowrk (network) at a specific point or period in time. Or an organisation (actor) acting as the dismantler (role) in a dismantling step of a building deconstruction process (process step) at a specific point or period in time." ;
                                    rdfs:label "Collaboration Participation" ,
                                               "Collaboration participation" .


###  http://w3id.org/CEON/ontology/actorODP/Infrastructure
actorODP:Infrastructure rdf:type owl:Class ;
                        rdfs:comment "An infrastructure refers to facilities, services, or systems for participations to function." ;
                        rdfs:label "Infrastructure" .


###  http://w3id.org/CEON/ontology/actorODP/Participation
actorODP:Participation rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Class ;
                                         owl:unionOf ( [ rdf:type owl:Restriction ;
                                                         owl:onProperty actorODP:participationStartTime ;
                                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty actorODP:participationTimePoint ;
                                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                                       ]
                                                     )
                                       ] ;
                       rdfs:comment "Represents the participation of objects in some situation." ;
                       rdfs:label "Participation" .


###  http://w3id.org/CEON/ontology/actorODP/ProcessParticipation
actorODP:ProcessParticipation rdf:type owl:Class .


###  http://w3id.org/CEON/ontology/actorODP/ResourceParticipation
actorODP:ResourceParticipation rdf:type owl:Class ;
                               rdfs:subClassOf actorODP:Participation ;
                               rdfs:comment "The generic relation representing the particpation of a resource in some relation. For example, it can be specialized to represent a reified version of an object or data property." ;
                               rdfs:label "Resource Participation" ,
                                          "Resource participation" .


###  http://w3id.org/CEON/ontology/actorODP/ResourceRelation
actorODP:ResourceRelation rdf:type owl:Class ;
                          rdfs:subClassOf actorODP:Participation ,
                                          [ owl:intersectionOf ( actorODP:Participation
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty actorODP:participantRole ;
                                                                   owl:someValuesFrom actor:ActorResourceRole
                                                                 ]
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty actorODP:participatingActor ;
                                                                   owl:someValuesFrom actorODP:Actor
                                                                 ]
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty actorODP:participatingResource ;
                                                                   owl:someValuesFrom resourceODP:Resource
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                          rdfs:comment "A relation between a resource, an actor, and the role the actor has in relation to the resource. For instance, the role of owner that a certain actor takes for a certain resource for a certain period of time. Or the seller of a certain resource, until that resource has been sold, and the actor no longer has that role in relation to the resource." ,
                                       "The relation involving the role of a certain actor with respect to a certain resource, e.g. an organisation or individual (actor) owning (role) a specific product (resource) at a specific point or period in time." ;
                          rdfs:label "Resource Relation" .


###  http://w3id.org/CEON/ontology/actorODP/Role
actorODP:Role rdf:type owl:Class ;
              rdfs:subClassOf <http://www.w3.org/ns/prov#Role> ;
              rdfs:comment "A role that an actor can take in a specific context. Applies both to roles in the context of resources, such as owner, manufacturer, reseller etc. of that resource, as well as roles in relation to a circular value network, such as recycler, dismantler, transporter etc., in relation to a material flow." ;
              rdfs:label "Role" .


###  http://w3id.org/CEON/ontology/cvn/CVN
cvn:CVN rdf:type owl:Class ;
        rdfs:subClassOf cvn:Collaboration ;
        rdfs:comment "A network of interlinked value chains and interested parties."@en ;
        rdfs:isDefinedBy "ISO 59004:2024 - 3.5.3 value network" ;
        rdfs:label "Circular Value Network" .


###  http://w3id.org/CEON/ontology/cvn/CVNBlueprint
cvn:CVNBlueprint rdf:type owl:Class ;
                 rdfs:comment "A plan or a pattern of a CVN configuration that can then be filled with actual actors and processes. The blueprint can be used to capture a desired setup of a network, or for reusing patterns of CVNs." ;
                 rdfs:label "Circular Value Network Blueprint" .


###  http://w3id.org/CEON/ontology/cvn/CircularStrategy
cvn:CircularStrategy rdf:type owl:Class ;
                     rdfs:comment "A circular strategy, such as to reccycle, reuse or refurbish something." ;
                     rdfs:label "Circular Strategy" .


###  http://w3id.org/CEON/ontology/cvn/Collaboration
cvn:Collaboration rdf:type owl:Class ;
                  rdfs:comment "A collaboration between a set of actors." ;
                  rdfs:label "Collaboration" .


###  http://w3id.org/CEON/ontology/energy/Biofuel
energy:Biofuel rdf:type owl:Class ;
               rdfs:subClassOf energy:Biomass ;
               rdfs:comment "Biofuel is a fuel that is produced over a short time span from biomass." ;
               rdfs:label "Biofuel" ;
               rdfs:seeAlso "https://en.wikipedia.org/wiki/Biofuel" .


###  http://w3id.org/CEON/ontology/energy/Biogas
energy:Biogas rdf:type owl:Class ;
              rdfs:subClassOf energy:Biomass ;
              rdfs:comment "Biogas represents an energy source that is produced from raw materials such as agricultural waste, manure, municipal waste, plant material, sewage, green waste, wastewater, and food waste." ;
              rdfs:label "Biogass" ;
              rdfs:seeAlso "https://en.wikipedia.org/wiki/Biogas" .


###  http://w3id.org/CEON/ontology/energy/Biomass
energy:Biomass rdf:type owl:Class ;
               rdfs:subClassOf energy:EnergySource ;
               rdfs:comment "Biomass represents matter from recently living (but now dead) organisms such as plants, algae and animals." ;
               rdfs:label "Biomass" ;
               rdfs:seeAlso "https://en.wikipedia.org/wiki/Biomass" .


###  http://w3id.org/CEON/ontology/energy/Coal
energy:Coal rdf:type owl:Class ;
            rdfs:subClassOf energy:FossilFuel ;
            rdfs:comment "Coal is a black or dark-brown combustible mineral substance consisting of carbonized vegetable matter." ;
            rdfs:label "Coal" ;
            rdfs:seeAlso "https://en.wikipedia.org/wiki/Coal" .


###  http://w3id.org/CEON/ontology/energy/Energy
energy:Energy rdf:type owl:Class ;
              rdfs:subClassOf resourceODP:Resource ;
              rdfs:comment "An amount of energy." ,
                           "Energy is an ability or a property of matter or a system, to do work because of its motion, its mass, its electric charge, etc." ;
              rdfs:label "Energy" ;
              rdfs:seeAlso "http://emmo.info/emmo#EMMO_31ec09ba_1713_42cb_83c7_b38bf6f9ced2" .


###  http://w3id.org/CEON/ontology/energy/EnergyComposition
energy:EnergyComposition rdf:type owl:Class ;
                         rdfs:subClassOf actorODP:ResourceParticipation ;
                         rdfs:comment "The relation representing the particpation of an energy as a resource." ;
                         rdfs:label "Energy Composition" .


###  http://w3id.org/CEON/ontology/energy/EnergyConversion
energy:EnergyConversion rdf:type owl:Class ;
                        rdfs:subClassOf actorODP:ResourceRelation ;
                        rdfs:comment "Energy Conversion is a process of transforming energy." ;
                        rdfs:label "Energy Conversion" .


###  http://w3id.org/CEON/ontology/energy/EnergyInfrastructure
energy:EnergyInfrastructure rdf:type owl:Class ;
                            rdfs:subClassOf actorODP:Infrastructure ;
                            rdfs:comment "The infrastructures participating in various energy-related processes, including energy production, transmission or distribution." ;
                            rdfs:label "Energy Infrastructure" .


###  http://w3id.org/CEON/ontology/energy/EnergySource
energy:EnergySource rdf:type owl:Class ;
                    rdfs:comment "An energy source is a resource or system that provides the energy." ;
                    rdfs:label "Energy Source" .


###  http://w3id.org/CEON/ontology/energy/FossilFuel
energy:FossilFuel rdf:type owl:Class ;
                  rdfs:subClassOf energy:EnergySource ;
                  rdfs:comment "A fossil fuel is a carbon compound- or hydrocarbon-containing material[2] formed naturally in the Earth's crust from the buried remains of prehistoric organisms (animals, plants or planktons), a process that occurs within geological formations." ;
                  rdfs:label "Fossil Fuel" ;
                  rdfs:seeAlso "https://en.wikipedia.org/wiki/Fossil_fuel" .


###  http://w3id.org/CEON/ontology/energy/GeothermalEnergySource
energy:GeothermalEnergySource rdf:type owl:Class ;
                              rdfs:subClassOf energy:EnergySource ;
                              rdfs:comment "Geothermal Energy Source is the Earth's crust. Geothermal energy is thermal energy extracted from the Earth's crust. It combines energy from the formation of the planet and from radioactive decay." ;
                              rdfs:label "Geothermal Energy Source" ;
                              rdfs:seeAlso "https://en.wikipedia.org/wiki/Geothermal_energy" .


###  http://w3id.org/CEON/ontology/energy/Hydropower
energy:Hydropower rdf:type owl:Class ;
                  rdfs:subClassOf energy:EnergySource ;
                  rdfs:comment "Hydropower is the use of falling or fast-running water to produce electricity or to power machines." ;
                  rdfs:label "Hydropower" ;
                  rdfs:seeAlso "https://en.wikipedia.org/wiki/Hydropower" .


###  http://w3id.org/CEON/ontology/energy/NaturalGas
energy:NaturalGas rdf:type owl:Class ;
                  rdfs:subClassOf energy:FossilFuel ;
                  rdfs:comment "Natural gas is a combustible gas that is naturally generated and stored under certain geological conditions by ancient animals and plants buried deep underground. It is a gaseous mixture of hydrocarbons and non-hydrocarbons, with methane as its main component." ;
                  rdfs:label "Natural Gas" ;
                  rdfs:seeAlso "https://en.wikipedia.org/wiki/Natural_gas" .


###  http://w3id.org/CEON/ontology/energy/NonRenewableEnergy
energy:NonRenewableEnergy rdf:type owl:Class ;
                          rdfs:subClassOf energy:Energy ;
                          rdfs:comment "Nonrenewable energy represents energy that comes from such resources that cannot be replaced onew they are used up." ;
                          rdfs:label "NonReneable Energy" .


