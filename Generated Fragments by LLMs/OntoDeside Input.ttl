                                                          rdfs:range <http://w3id.org/CEON/ontology/quantity#QuantityInterval> ;
                                                          rdfs:label "has mass fraction of product released into environment" .


###  http://w3id.org/CEON/ontology/statement/hasMassFractionOfRecycledMaterialsOutOfTheTotalProductMass
statement:hasMassFractionOfRecycledMaterialsOutOfTheTotalProductMass rdf:type owl:ObjectProperty ;
                                                                     rdfs:subPropertyOf statement:hasQuantityInterval ;
                                                                     rdfs:domain statement:RecycledMaterialStatement ;
                                                                     rdfs:range <http://w3id.org/CEON/ontology/quantity#QuantityInterval> ;
                                                                     rdfs:label "has mass fraction of recycled materials out of the total product mass" .


###  http://w3id.org/CEON/ontology/statement/hasMassFractionOfRenewableMaterialsOutOfTheTotalProductMass
statement:hasMassFractionOfRenewableMaterialsOutOfTheTotalProductMass rdf:type owl:ObjectProperty ;
                                                                      rdfs:subPropertyOf statement:hasQuantityInterval ;
                                                                      rdfs:domain statement:SustainablyProducedRenewableMaterialStatement ;
                                                                      rdfs:range <http://w3id.org/CEON/ontology/quantity#QuantityInterval> ;
                                                                      rdfs:label "has mass fraction of renewable materials out of the total product mass" .


###  http://w3id.org/CEON/ontology/statement/hasMassFractionOfReusedPartsOutOfTheTotalProduct
statement:hasMassFractionOfReusedPartsOutOfTheTotalProduct rdf:type owl:ObjectProperty ;
                                                           rdfs:subPropertyOf statement:hasQuantityInterval ;
                                                           rdfs:domain statement:ReusedContentStatement ;
                                                           rdfs:range <http://w3id.org/CEON/ontology/quantity#QuantityInterval> ;
                                                           rdfs:label "has mass fraction of reused parts out of the total product" .


###  http://w3id.org/CEON/ontology/statement/hasPostConsumerRecycledMaterialCompositionThreshold
statement:hasPostConsumerRecycledMaterialCompositionThreshold rdf:type owl:ObjectProperty ;
                                                              rdfs:subPropertyOf statement:hasQuantityInterval ;
                                                              rdfs:domain statement:RecycledMaterialStatement ;
                                                              rdfs:range <http://w3id.org/CEON/ontology/quantity#QuantityInterval> ;
                                                              rdfs:label "has post consumer recycled material composition threshold" .


###  http://w3id.org/CEON/ontology/statement/hasPreConsumerRecycledMaterialCompositionThreshold
statement:hasPreConsumerRecycledMaterialCompositionThreshold rdf:type owl:ObjectProperty ;
                                                             rdfs:subPropertyOf statement:hasQuantityInterval ;
                                                             rdfs:domain statement:RecycledMaterialStatement ;
                                                             rdfs:range <http://w3id.org/CEON/ontology/quantity#QuantityInterval> ;
                                                             rdfs:label "has pre consumer recycled material composition threshold" .


###  http://w3id.org/CEON/ontology/statement/hasQuantityInterval
statement:hasQuantityInterval rdf:type owl:ObjectProperty ;
                              rdfs:range <http://w3id.org/CEON/ontology/quantity#QuantityInterval> ;
                              rdfs:label "has quantity interval" .


###  http://w3id.org/CEON/ontology/statement/hasValidation
statement:hasValidation rdf:type owl:ObjectProperty ;
                        rdfs:range statement:Validation ;
                        rdfs:label "has validation" .


###  http://w3id.org/CEON/ontology/statement/hasVolumeFractionOfReductionOfDirectWaterConsumptionUsedInProduction
statement:hasVolumeFractionOfReductionOfDirectWaterConsumptionUsedInProduction rdf:type owl:ObjectProperty ;
                                                                               rdfs:subPropertyOf statement:hasQuantityInterval ;
                                                                               rdfs:domain statement:WaterReuseOrRecirculationStatement ;
                                                                               rdfs:range <http://w3id.org/CEON/ontology/quantity#QuantityInterval> ;
                                                                               rdfs:label "has volume fraction of reduction of direct water consumption used in production" .


###  http://w3id.org/CEON/ontology/statement/hasVolumeFractionOfReusedOrRecirculatedWaterUsedInProduction
statement:hasVolumeFractionOfReusedOrRecirculatedWaterUsedInProduction rdf:type owl:ObjectProperty ;
                                                                       rdfs:subPropertyOf statement:hasQuantityInterval ;
                                                                       rdfs:domain statement:WaterReuseOrRecirculationStatement ;
                                                                       rdfs:range <http://w3id.org/CEON/ontology/quantity#QuantityInterval> ;
                                                                       rdfs:label "has volume fraction of reused or recirculated water used in production" .


###  http://w3id.org/CEON/ontology/statement/statementAbout
statement:statementAbout rdf:type owl:ObjectProperty ;
                         rdfs:domain statement:Statement ;
                         rdfs:comment "Generic property to express what the statement is about, i.e. what is involved in the statement." ;
                         rdfs:label "statement about" .


###  http://w3id.org/CEON/ontology/value/hasAimedValue
value:hasAimedValue rdf:type owl:ObjectProperty ;
                    rdfs:domain value:ValueProposition ;
                    rdfs:range value:Value ;
                    rdfs:comment "A value proposition has specific aimed values." ;
                    rdfs:label "has aimed value" .


###  http://w3id.org/CEON/ontology/value/hasAssociatedValue
value:hasAssociatedValue rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf owl:topObjectProperty ;
                         rdfs:domain value:ValuePerception ;
                         rdfs:range value:Value ;
                         rdfs:comment "A value perception about creating/destoring/missing some value." ;
                         rdfs:label "has associated value" .


###  http://w3id.org/CEON/ontology/value/hasPerception
value:hasPerception rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( actorODP:Actor
                                                value:ValueProposition
                                              )
                                ] ;
                    rdfs:range value:ValuePerception ;
                    rdfs:comment "An actor perceive specific values, or a value proposition is about specific values." ;
                    rdfs:label "has perception" .


###  http://w3id.org/CEON/ontology/value/hasVPTargets
value:hasVPTargets rdf:type owl:ObjectProperty ;
                   rdfs:comment "A value proposition is proposed about specific actors, participations or resources." ;
                   rdfs:label "has value proposition targets" .


###  http://w3id.org/CEON/ontology/value/hasValuableResource
value:hasValuableResource rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf owl:topObjectProperty ;
                          rdfs:domain value:ValueParticipation ;
                          rdfs:range resourceODP:Resource ;
                          rdfs:comment "A value participation has participating resources." ;
                          rdfs:label "has valuable resource" .




###  http://w3id.org/CEON/ontology/value/onValueParticipation
value:onValueParticipation rdf:type owl:ObjectProperty ;
                           rdfs:domain value:ValuePerception ;
                           rdfs:range value:ValueParticipation ;
                           rdfs:comment "A perception is on specific value participations." ;
                           rdfs:label "on value participation" .


###  http://w3id.org/CEON/ontology/value/proposedBy
value:proposedBy rdf:type owl:ObjectProperty ;
                 rdfs:domain value:ValueProposition ;
                 rdfs:range actorODP:Actor ;
                 rdfs:comment "A value proposition is proposed by specific actors." ;
                 rdfs:label "proposed by" .


###  http://w3id.org/CEON/ontology/value/targettingActor
value:targettingActor rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf value:hasVPTargets ;
                      rdfs:domain value:ValueProposition ;
                      rdfs:range actorODP:Actor ;
                      rdfs:comment "A value proposition is about some actors." ;
                      rdfs:label "targetting actor" .


###  http://w3id.org/CEON/ontology/value/targettingResource
value:targettingResource rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf value:hasVPTargets ;
                         rdfs:domain value:ValueProposition ;
                         rdfs:range resourceODP:Resource ;
                         rdfs:comment "A value proposition is about some resources." ;
                         rdfs:label "targetting resource" .


###  http://w3id.org/CEON/ontology/value/targettingValueParticipation
value:targettingValueParticipation rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf value:hasVPTargets ;
                                   rdfs:domain value:ValueProposition ;
                                   rdfs:range value:ValueParticipation ;
                                   rdfs:comment "A value proposition is about some participation." ;
                                   rdfs:label "targetting value participation" .


#################################################################
#    Data properties
#################################################################

###  http://qudt.org/schema/qudt/numericValue
qudt:numericValue rdf:type owl:DatatypeProperty .



###  http://w3id.org/CEON/ontology/actorODP/participationEndTime
actorODP:participationEndTime rdf:type owl:DatatypeProperty ;
                              rdfs:domain actorODP:Participation ;
                              rdfs:range [ rdf:type rdfs:Datatype ;
                                           owl:unionOf ( xsd:date
                                                         xsd:dateTime
                                                         xsd:gMonthYear
                                                         xsd:gYear
                                                       )
                                         ] ;
                              rdfs:comment "The end of a time interval." ;
                              rdfs:label "participation end time" .


###  http://w3id.org/CEON/ontology/actorODP/participationStartTime
actorODP:participationStartTime rdf:type owl:DatatypeProperty ;
                                rdfs:domain actorODP:Participation ;
                                rdfs:range [ rdf:type rdfs:Datatype ;
                                             owl:unionOf ( xsd:date
                                                           xsd:dateTime
                                                           xsd:gMonthYear
                                                           xsd:gYear
                                                         )
                                           ] ;
                                rdfs:comment "The start of a time interval." ;
                                rdfs:label "participation start time" .


###  http://w3id.org/CEON/ontology/actorODP/participationTimePoint
actorODP:participationTimePoint rdf:type owl:DatatypeProperty ;
                                rdfs:domain actorODP:Participation ;
                                rdfs:range [ rdf:type rdfs:Datatype ;
                                             owl:unionOf ( xsd:date
                                                           xsd:dateTime
                                                           xsd:gMonthYear
                                                           xsd:gYear
                                                         )
                                           ] ;
                                rdfs:comment "The point in time when something took place or was valid." ;
                                rdfs:label "participation time point" .


###  http://w3id.org/CEON/ontology/energy/hasCarbonIntensity
energy:hasCarbonIntensity rdf:type owl:DatatypeProperty ;
                          rdfs:domain energy:EnergySource ;
                          rdfs:range xsd:double ;
                          rdfs:comment "hasCarbonIntensity measures how intensive that the carbon is for an energy source." ;
                          rdfs:label "has carbon intensity" .


###  http://w3id.org/CEON/ontology/energy/hasEnergyComponentPercentage
energy:hasEnergyComponentPercentage rdf:type owl:DatatypeProperty ;
                                    rdfs:domain energy:EnergyComposition ;
                                    rdfs:range xsd:double ;
                                    rdfs:comment "hasEnergyComponentPercentage represents the percentage of a particular energy as a composition." ;
                                    rdfs:label "has energy component percentage" .


###  http://w3id.org/CEON/ontology/energy/hasSustainability
energy:hasSustainability rdf:type owl:DatatypeProperty ;
                         rdfs:domain energy:EnergySource ;
                         rdfs:range xsd:double ;
                         rdfs:comment "hasSustainability measures how sustainable an energy source is." ;
                         rdfs:label "has sustainability" .


###  http://w3id.org/CEON/ontology/location/hasCity
location:hasCity rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf owl:topDataProperty ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Represents the name of a city." ;
                 rdfs:label "has city" .


###  http://w3id.org/CEON/ontology/location/hasCountry
location:hasCountry rdf:type owl:DatatypeProperty ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Represents the name of a country." ;
                    rdfs:label "has country" .


###  http://w3id.org/CEON/ontology/location/hasCountryCode
location:hasCountryCode rdf:type owl:DatatypeProperty ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Represents the code of a country's name according to ISO 3166-1." ;
                        rdfs:label "has country code" ;
                        rdfs:seeAlso "ISO 3166-1 (Codes for the representation of names of countries and their subdivisions – Part 1: Country code)" .


###  http://w3id.org/CEON/ontology/location/hasGlobalLocationNumber
location:hasGlobalLocationNumber rdf:type owl:DatatypeProperty ;
                                 rdfs:range xsd:string ;
                                 rdfs:comment "The Global Location Number (GLN) is part of the GS1 systems of standards." ;
                                 rdfs:label "has global location number" ;
                                 rdfs:seeAlso "https://www.gs1.org/standards/id-keys/gln" .


###  http://w3id.org/CEON/ontology/location/hasPostalCode
location:hasPostalCode rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf owl:topDataProperty ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Represent postal code" ;
                       rdfs:label "has postal code" ;
                       rdfs:seeAlso "Universal Postal Union (UPU) S42 standard" .


###  http://w3id.org/CEON/ontology/location/hasStreetAddress
location:hasStreetAddress rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf owl:topDataProperty ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Represents address of a street, including e.g., street number and name." ;
                          rdfs:label "has street address" .


###  http://w3id.org/CEON/ontology/material/anonymousFormula
material:anonymousFormula rdf:type owl:DatatypeProperty ;
                          rdfs:comment "anonymousFormula represents that a molecular entity has the anonymous formula in a string." ;
                          rdfs:label "anonymous formula" ;
                          rdfs:seeAlso "https://w3id.org/mdo/structure/AnonymousFormula" .


###  http://w3id.org/CEON/ontology/material/descriptiveFormula
material:descriptiveFormula rdf:type owl:DatatypeProperty ;
                            rdfs:comment "descriptiveFormula represents that a molecular entity has the descriptive formula in a string." ;
                            rdfs:label "descriptive formula" ;
                            rdfs:seeAlso "https://w3id.org/mdo/structure/DescriptiveFormula" .


###  http://w3id.org/CEON/ontology/material/hillFormula
material:hillFormula rdf:type owl:DatatypeProperty ;
                     rdfs:comment "hillFormula represents that a composition has the hill formula in a string." ;
                     rdfs:label "hill formula" ;
                     rdfs:seeAlso "https://w3id.org/mdo/structure/HillFormula" .


###  http://w3id.org/CEON/ontology/material/reducedChemicalFormula
material:reducedChemicalFormula rdf:type owl:DatatypeProperty ;
                                rdfs:comment "reducedChemicalFormula represents that a molecular entity has the reduced chemical formula in a string." ;
                                rdfs:label "reduced chemical formula" ;
                                rdfs:seeAlso "https://w3id.org/mdo/structure/ReducedFormula" .


###  http://w3id.org/CEON/ontology/processODP/endTime
processODP:endTime rdf:type owl:DatatypeProperty ;
                   rdfs:domain processODP:TimeInterval ;
                   rdfs:range xsd:dateTime ;
                   rdfs:comment "Represents the end time of a time interval." ;
                   rdfs:label "end time" .


###  http://w3id.org/CEON/ontology/processODP/startTime
processODP:startTime rdf:type owl:DatatypeProperty ;
                     rdfs:domain processODP:TimeInterval ;
                     rdfs:range xsd:dateTime ;
                     rdfs:comment "Represents the start time of a time interval." ;
                     rdfs:label "start time" .


###  http://w3id.org/CEON/ontology/product/compositionQuantity
product:compositionQuantity rdf:type owl:DatatypeProperty ;
                            rdfs:domain product:Composition ;
                            rdfs:range xsd:double ;
                            rdfs:comment "compositionQuantity represents the quantity of elements of a composition." ;
                            rdfs:label "composition quantity" .


###  http://w3id.org/CEON/ontology/product/countryOfAssembly
product:countryOfAssembly rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf location:hasCountry ;
                          rdfs:domain product:AssemblyLocation ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Used to represent the country of assembly of a product or product object (item)." ;
                          rdfs:label "Country of assembly" .


###  http://w3id.org/CEON/ontology/product/countryOfManufacture
product:countryOfManufacture rdf:type owl:DatatypeProperty ;
                             rdfs:subPropertyOf location:hasCountry ;
                             rdfs:domain product:ManufactureLocation ;
                             rdfs:range xsd:string ;
                             rdfs:comment "Used to represent the country of manufacture of a product or product object (item)." ;
                             rdfs:label "Country of manufacture" .


###  http://w3id.org/CEON/ontology/product/countryOfOrigin
product:countryOfOrigin rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf location:hasCountry ;
                        rdfs:domain product:OriginLocation ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Used to represent the country of origin of a product or product object (item)." ;
                        rdfs:label "Country of origin" .


###  http://w3id.org/CEON/ontology/product/countryOfProduction
product:countryOfProduction rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf location:hasCountry ;
                            rdfs:domain product:ProductionLocation ;
                            rdfs:range xsd:string ;
                            rdfs:comment "Used to represent the country of production of a product or product object (item)." ;
                            rdfs:label "Country of production" .


###  http://w3id.org/CEON/ontology/product/hasBrand
product:hasBrand rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:string ;
                 rdfs:comment "The brand name of a product." ;
                 rdfs:label "has brand" .


###  http://w3id.org/CEON/ontology/product/hasCertificate
product:hasCertificate rdf:type owl:DatatypeProperty ;
                       rdfs:domain product:Compliance ;
                       rdfs:comment "Link to the the certificate that certifies the compliance" ;
                       rdfs:label "has certificate" .


###  http://w3id.org/CEON/ontology/product/hasGlobalTradeItemNumber
product:hasGlobalTradeItemNumber rdf:type owl:DatatypeProperty ;
                                 rdfs:range xsd:string ;
                                 rdfs:label "Global Trade Item Number (GTIN)" ;
                                 rdfs:seeAlso "https://www.gs1.org/standards/id-keys/gtin" .


###  http://w3id.org/CEON/ontology/product/hasProductName
product:hasProductName rdf:type owl:DatatypeProperty ;
                       rdfs:range xsd:string ;
                       rdfs:comment "The name of a product." ;
                       rdfs:label "product name" .


###  http://w3id.org/CEON/ontology/product/productionSite
product:productionSite rdf:type owl:DatatypeProperty ;
                       rdfs:domain product:ProductionLocation ;
                       rdfs:range xsd:string ;
                       rdfs:comment "The name of a production site location" ;
                       rdfs:label "production site" .


###  http://w3id.org/CEON/ontology/quantity/numericalMaxValue
quantity:numericalMaxValue rdf:type owl:DatatypeProperty ;
                           rdfs:range xsd:double ;
                           rdfs:comment "represents the maximal value of a quantity" ;
                           rdfs:label "numerical max value" .


###  http://w3id.org/CEON/ontology/quantity/numericalMinValue
quantity:numericalMinValue rdf:type owl:DatatypeProperty ;
                           rdfs:subPropertyOf owl:topDataProperty ;
                           rdfs:range xsd:double ;
                           rdfs:comment "represents the minimal value of a quantity" ;
                           rdfs:label "numerical min value" .


###  http://w3id.org/CEON/ontology/resourceODP/batchID
resourceODP:batchID rdf:type owl:DatatypeProperty ;
                    rdfs:domain resourceODP:BatchOfObjects ;
                    rdfs:range xsd:string ;
                    rdfs:comment "identifier for a batch" ;
                    rdfs:label "batch ID" .


###  http://w3id.org/CEON/ontology/resourceODP/batchLabel
resourceODP:batchLabel rdf:type owl:DatatypeProperty ;
                       rdfs:domain resourceODP:BatchOfObjects ;
                       rdfs:range xsd:string ;
                       rdfs:comment "label for a batch" ;
                       rdfs:label "batch label" .


###  http://w3id.org/CEON/ontology/resourceODP/batchSize
resourceODP:batchSize rdf:type owl:DatatypeProperty ;
                      rdfs:domain resourceODP:BatchOfObjects ;
                      rdfs:range xsd:nonNegativeInteger ;
                      rdfs:comment "batchSize intends to repsent how many physical objects are belong to a batch of objects." ;
                      rdfs:label "batch size" .


###  http://w3id.org/CEON/ontology/statement/availableEndDate
statement:availableEndDate rdf:type owl:DatatypeProperty ;
                           rdfs:range xsd:date ;
                           rdfs:label "available end date" .


###  http://w3id.org/CEON/ontology/statement/availableStartDate
statement:availableStartDate rdf:type owl:DatatypeProperty ;
                             rdfs:range xsd:date ;
                             rdfs:label "available start date" .


###  http://w3id.org/CEON/ontology/statement/isPCDSStatementTrue
statement:isPCDSStatementTrue rdf:type owl:DatatypeProperty ;
                              rdfs:range xsd:boolean ;
                              rdfs:label "is PCDS statement true" .


###  http://w3id.org/CEON/ontology/statement/statementValue
statement:statementValue rdf:type owl:DatatypeProperty ;
                         rdfs:domain statement:Statement ;
                         rdfs:comment "Generic property to express values, e.g. literals, that are involved in this statement." ;
                         rdfs:label "statement value" .


###  http://www.opengis.net/ont/geosparql#asGML
<http://www.opengis.net/ont/geosparql#asGML> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <http://www.opengis.net/ont/geosparql#Geometry> ;
                                             rdfs:range <http://www.opengis.net/ont/geosparql#gmlLiteral> ;
                                             rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/geometry-as-wkt-literal> ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "The GML serialization of a Geometry."@en ;
                                             <http://www.w3.org/2004/02/skos/core#prefLabel> "as GML"@en .


###  http://www.opengis.net/ont/geosparql#asGeoJSON
<http://www.opengis.net/ont/geosparql#asGeoJSON> rdf:type owl:DatatypeProperty ;
                                                 rdfs:domain <http://www.opengis.net/ont/geosparql#Geometry> ;
                                                 rdfs:range <http://www.opengis.net/ont/geosparql#geoJSONLiteral> ;
                                                 rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/geometry-as-wkt-literal> ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "The GeoJSON serialization of a Geometry."@en ;
                                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "as GeoJSON"@en .


###  http://www.opengis.net/ont/geosparql#asWKT
<http://www.opengis.net/ont/geosparql#asWKT> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <http://www.opengis.net/ont/geosparql#Geometry> ;
                                             rdfs:range <http://www.opengis.net/ont/geosparql#wktLiteral> ;
                                             rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/geometry-as-wkt-literal> ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "The WKT serialization of a Geometry."@en ;
                                             <http://www.w3.org/2004/02/skos/core#prefLabel> "as WKT"@en .


###  http://www.w3.org/2003/01/geo/wgs84_pos#lat
<http://www.w3.org/2003/01/geo/wgs84_pos#lat> rdf:type owl:DatatypeProperty .


