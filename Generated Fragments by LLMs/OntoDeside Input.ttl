###  http://w3id.org/CEON/ontology/process/DismantleProcess
process:DismantleProcess rdf:type owl:Class ;
                         rdfs:subClassOf process:TransformationProcess ;
                         rdfs:comment "A process of dismantling." ;
                         rdfs:label "Dismantle Process" .


###  http://w3id.org/CEON/ontology/process/EnsureClaimProcess
process:EnsureClaimProcess rdf:type owl:Class ;
                           rdfs:subClassOf processODP:Process ;
                           rdfs:comment "A process of ensuring a claim." ;
                           rdfs:label "Ensure Claim Process" .


###  http://w3id.org/CEON/ontology/process/IssuingCertificateProcess
process:IssuingCertificateProcess rdf:type owl:Class ;
                                  rdfs:subClassOf process:TransformationProcess ;
                                  rdfs:comment "A process of issuing a certificate." ;
                                  rdfs:label "Issuing Certificate Process" .


###  http://w3id.org/CEON/ontology/process/ManufacturingProcess
process:ManufacturingProcess rdf:type owl:Class ;
                             rdfs:subClassOf process:TransformationProcess ;
                             rdfs:comment "A process of manufacturing." ;
                             rdfs:label "Manufacturing Process" .


###  http://w3id.org/CEON/ontology/process/OffsetProcess
process:OffsetProcess rdf:type owl:Class ;
                      rdfs:subClassOf process:TransformationProcess ;
                      rdfs:comment "A process of offsetting." ;
                      rdfs:label "Offset Process" .


###  http://w3id.org/CEON/ontology/process/ProductionProcess
process:ProductionProcess rdf:type owl:Class ;
                          rdfs:subClassOf process:TransformationProcess ;
                          rdfs:comment "A process of production." ;
                          rdfs:label "Production Process" .


###  http://w3id.org/CEON/ontology/process/RecycleProcess
process:RecycleProcess rdf:type owl:Class ;
                       rdfs:subClassOf process:TransformationProcess ;
                       rdfs:comment "A process of recycling." ;
                       rdfs:label "Recycle Process" .


###  http://w3id.org/CEON/ontology/process/RefurbishmentProcess
process:RefurbishmentProcess rdf:type owl:Class ;
                             rdfs:subClassOf process:TransformationProcess ;
                             rdfs:comment "A process of refurbishment." ;
                             rdfs:label "Refurbishment Process" .


###  http://w3id.org/CEON/ontology/process/RemoveProcess
process:RemoveProcess rdf:type owl:Class ;
                      rdfs:subClassOf processODP:Process ;
                      rdfs:comment "A process of removing." ;
                      rdfs:label "Remove Process" .


###  http://w3id.org/CEON/ontology/process/RemoveResourceProcess
process:RemoveResourceProcess rdf:type owl:Class ;
                              rdfs:subClassOf process:TransformationProcess ;
                              rdfs:comment "A process of removing a resource." ;
                              rdfs:label "Remove Resource Process" .


###  http://w3id.org/CEON/ontology/process/RepairProcess
process:RepairProcess rdf:type owl:Class ;
                      rdfs:subClassOf process:TransformationProcess ;
                      rdfs:comment "A process of repairing." ;
                      rdfs:label "Repair Process" .


###  http://w3id.org/CEON/ontology/process/ResellProcess
process:ResellProcess rdf:type owl:Class ;
                      rdfs:subClassOf processODP:Process ;
                      rdfs:comment "A process of reselling." ;
                      rdfs:label "Resell Process" .


###  http://w3id.org/CEON/ontology/process/ReuseProcess
process:ReuseProcess rdf:type owl:Class ;
                     rdfs:subClassOf processODP:Process ;
                     rdfs:comment "A process of reusing." ;
                     rdfs:label "Reuse Process" .


###  http://w3id.org/CEON/ontology/process/SellResourceProcess
process:SellResourceProcess rdf:type owl:Class ;
                            rdfs:subClassOf processODP:Process ;
                            rdfs:comment "A process of selling a resource." ;
                            rdfs:label "Sell Resource Process" .


###  http://w3id.org/CEON/ontology/process/ServiceProcess
process:ServiceProcess rdf:type owl:Class ;
                       rdfs:subClassOf process:TransformationProcess ;
                       rdfs:comment "A process of servicing." ;
                       rdfs:label "Service Process" .


###  http://w3id.org/CEON/ontology/process/ShareResourceProcess
process:ShareResourceProcess rdf:type owl:Class ;
                             rdfs:subClassOf processODP:Process ;
                             rdfs:comment "A process of sharing a resource." ;
                             rdfs:label "Share Resource Process" .


###  http://w3id.org/CEON/ontology/process/TakeBackProcess
process:TakeBackProcess rdf:type owl:Class ;
                        rdfs:subClassOf processODP:Process ;
                        rdfs:comment "A process of taking back." ;
                        rdfs:label "Take Back Process" .


###  http://w3id.org/CEON/ontology/process/TransformationProcess
process:TransformationProcess rdf:type owl:Class ;
                              rdfs:subClassOf processODP:Process ;
                              rdfs:comment "Set of interrelated or interacting activities that transforms inputs into outputs."@en ;
                              rdfs:isDefinedBy "ISO 59004:2024  - 3.5.5 process" ;
                              rdfs:label "Transformation Process" ;
                              rdfs:seeAlso "https://ref.gs1.org/epcis/Transformation" .


###  http://w3id.org/CEON/ontology/process/Transition
process:Transition rdf:type owl:Class ;
                   rdfs:subClassOf processODP:Situation ;
                   rdfs:comment "A transition is a situation that creates a context for two additional different Situations, one Process, and at least one Object: one Situation is the state before the transition, the second Situation is the state after the transition, the Process is the invariance under some different transitions, in which at least one Object is situated. Finally, one or more time interval(s) may position the situations and the transitional event in time, and we may include the event that triggered the transition as well." ;
                   rdfs:label "Transition" .


###  http://w3id.org/CEON/ontology/processODP/Event
processODP:Event rdf:type owl:Class ;
                 rdfs:subClassOf [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                          owl:onProperty processODP:hasInput ;
                                                          owl:someValuesFrom owl:Thing
                                                        ]
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty processODP:hasOutput ;
                                                          owl:someValuesFrom owl:Thing
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty processODP:hasPart ;
                                   owl:allValuesFrom processODP:Event
                                 ] ;
                 rdfs:comment "Something that happens within a given context or (short) timeframe." ;
                 rdfs:label "Event" ;
                 rdfs:seeAlso "https://ref.gs1.org/epcis/EPCISEvent" .


###  http://w3id.org/CEON/ontology/processODP/Process
processODP:Process rdf:type owl:Class ;
                   rdfs:subClassOf [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                            owl:onProperty processODP:hasInput ;
                                                            owl:someValuesFrom owl:Thing
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty processODP:hasOutput ;
                                                            owl:someValuesFrom owl:Thing
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty processODP:hasPart ;
                                     owl:allValuesFrom [ rdf:type owl:Class ;
                                                         owl:unionOf ( processODP:Event
                                                                       processODP:Process
                                                                     )
                                                       ]
                                   ] ;
                   rdfs:comment "Something that takes place over a (longer) period of time and changes some state of affairs."@en ;
                   rdfs:label "Process" .


###  http://w3id.org/CEON/ontology/processODP/Situation
processODP:Situation rdf:type owl:Class ;
                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                       owl:onProperty processODP:isSettingFor ;
                                       owl:someValuesFrom owl:Thing
                                     ] ;
                     rdfs:comment "A situation that may involve some resources and actors, i.e. a state of affairs at a certain point in time." ;
                     rdfs:label "Situation" .


###  http://w3id.org/CEON/ontology/processODP/TimeInterval
processODP:TimeInterval rdf:type owl:Class ;
                        rdfs:comment "A temporal entity has a starting time and an ending time." ;
                        rdfs:label "Time Interval" .


###  http://w3id.org/CEON/ontology/product/AssemblyLocation
product:AssemblyLocation rdf:type owl:Class ;
                         rdfs:subClassOf location:Location ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty location:hasCity ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty location:hasPostalCode ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty location:hasStreetAddress ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty product:countryOfAssembly ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ;
                         rdfs:comment "The location where a physical object is assembled." ;
                         rdfs:label "Assembly Location" .


###  http://w3id.org/CEON/ontology/product/Compliance
product:Compliance rdf:type owl:Class ;
                   rdfs:comment "Represents that something is compliant with some standard or has a received a certain certification." ;
                   rdfs:label "Compliance" .


###  http://w3id.org/CEON/ontology/product/Composition
product:Composition rdf:type owl:Class ;
                    rdfs:subClassOf actorODP:ResourceParticipation ;
                    rdfs:comment "A relation that represents a composing relation." ;
                    rdfs:label "Composition" .


###  http://w3id.org/CEON/ontology/product/ISOCompliance
product:ISOCompliance rdf:type owl:Class ;
                      rdfs:subClassOf product:Compliance ;
                      rdfs:comment "ISO compliance is a compliance issuing thay sth (e.g., organization's structure, business operations, practices or policies) follows a specific ISO standard." ;
                      rdfs:label "ISO Compliance" .


###  http://w3id.org/CEON/ontology/product/Item
product:Item rdf:type owl:Class ;
             rdfs:subClassOf resourceODP:PhysicalObject ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty product:modelledBy ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass product:Product
                             ] ;
             rdfs:comment "An item is a physical object put into a market for sale, i.e. corresponding to an individual of a product. The item can be a thing that grows naturally or produced through some chemical or manufacturing processes." ;
             rdfs:label "Item" .


###  http://w3id.org/CEON/ontology/product/ManufactureLocation
product:ManufactureLocation rdf:type owl:Class ;
                            rdfs:subClassOf location:Location ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty location:hasCity ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty location:hasPostalCode ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty location:hasStreetAddress ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty product:countryOfManufacture ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ;
                            rdfs:comment "The location where a physical object is manufactured." ;
                            rdfs:label "Manufacture Location" .


###  http://w3id.org/CEON/ontology/product/MatterComposition
product:MatterComposition rdf:type owl:Class ;
                          rdfs:subClassOf product:Composition ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty product:associatedWithMatter ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass resourceODP:Matter
                                          ] ;
                          rdfs:comment "A product composition is the composed information of a product in terms of a specific component, in which such a component is also a matter." ;
                          rdfs:label "Matter composition" .


###  http://w3id.org/CEON/ontology/product/OriginLocation
product:OriginLocation rdf:type owl:Class ;
                       rdfs:subClassOf location:Location ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty location:hasCity ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty location:hasPostalCode ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty location:hasStreetAddress ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty product:countryOfOrigin ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ;
                       rdfs:comment "The origin location of a physical object" ;
                       rdfs:label "Origin Location" .


###  http://w3id.org/CEON/ontology/product/Product
product:Product rdf:type owl:Class ;
                rdfs:subClassOf product:Solution ,
                                resourceODP:Resource ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty product:hasComposition ;
                                  owl:someValuesFrom product:MatterComposition
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty product:hasComposition ;
                                  owl:someValuesFrom product:ProductComposition
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty product:hasAssemblyLocation ;
                                  owl:allValuesFrom product:AssemblyLocation
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty product:hasManufacturerLocation ;
                                  owl:allValuesFrom product:ManufactureLocation
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty product:hasOriginLocation ;
                                  owl:allValuesFrom product:OriginLocation
                                ] ;
                rdfs:comment "Physical-based object designed for or utilized with a purpose. A product can be, for example: goods of any type; hardware (e.g. engine mechanical part, spare parts, consumables); electrical or electronic hardware devices or components (e.g. computers, communication equipment and sensors); processed materials (e.g. lubricant, cement)." ,
                             "Represents the common sense notion of a product, i.e. the abstract notion of a product type, which is a model that is used for manufacturing items of that product." ;
                rdfs:isDefinedBy "ISO 59004:2024 -3.2.2 product" ;
                rdfs:label "Product" .


###  http://w3id.org/CEON/ontology/product/ProductComposition
product:ProductComposition rdf:type owl:Class ;
                           rdfs:subClassOf product:Composition ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty product:associatedWithProductModel ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass product:Product
                                           ] ;
                           rdfs:comment "A product composition is the composed information of a product in terms of a specific component, in which such a component is also a product." ;
                           rdfs:label "Product composition" .


###  http://w3id.org/CEON/ontology/product/ProductObjectComposition
product:ProductObjectComposition rdf:type owl:Class ;
                                 rdfs:subClassOf product:Composition ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty product:associatedWithProductObject ;
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass product:Item
                                                 ] ;
                                 rdfs:comment "A product object composition is the composed information of a product object in terms of a specific component, in which such a component is also a product object." ;
                                 rdfs:label "Product Object Composition" .


###  http://w3id.org/CEON/ontology/product/ProductionLocation
product:ProductionLocation rdf:type owl:Class ;
                           rdfs:subClassOf location:Location ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty location:hasCity ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty location:hasPostalCode ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty location:hasStreetAddress ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty product:countryOfProduction ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty product:productionSite ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ;
                           rdfs:comment "The production location of a physical object" ;
                           rdfs:label "Production Location" .


###  http://w3id.org/CEON/ontology/product/REACHCompliance
product:REACHCompliance rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty product:complianceWith ;
                                              owl:hasValue product:REACH
                                            ] ;
                        rdfs:subClassOf product:Compliance ;
                        rdfs:comment "REACH (Regulation on the registration, evaluation, authorisation and restriction of chemicals) compliance is a compliance issueing that the REACH regulation is satisfied." ;
                        rdfs:label "REACH Compliance" ;
                        rdfs:seeAlso "https://environment.ec.europa.eu/topics/chemicals/reach-regulation_en" .


###  http://w3id.org/CEON/ontology/product/Regulation
product:Regulation rdf:type owl:Class ;
                   rdfs:comment "The rules or restrictions made or maintained by authorities." ;
                   rdfs:label "Regulation" .


###  http://w3id.org/CEON/ontology/product/RoHSCompliance
product:RoHSCompliance rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty product:complianceWith ;
                                             owl:hasValue product:RoHS
                                           ] ;
                       rdfs:subClassOf product:Compliance ;
                       rdfs:comment "RoHS (Restriction of Hazardous Substances in Electrical and Electronic Equipment) compliance is a compliance issuing that RoHS objectives are satisfied." ;
                       rdfs:label "RoHS Compliance" ;
                       rdfs:seeAlso "https://environment.ec.europa.eu/topics/waste-and-recycling/rohs-directive_en" .


###  http://w3id.org/CEON/ontology/product/Solution
product:Solution rdf:type owl:Class ;
                 rdfs:comment "Product or service, or a combination thereof, that fulfils a need of an interested party." ;
                 rdfs:isDefinedBy "ISO 59004:2024 - 3.2.1 solution" ;
                 rdfs:label "Solution" .


###  http://w3id.org/CEON/ontology/product/SupplierLocation
product:SupplierLocation rdf:type owl:Class ;
                         rdfs:subClassOf location:Location ;
                         rdfs:comment "The location of supplier of a product or item." ;
                         rdfs:label "Supplier Location" .


###  http://w3id.org/CEON/ontology/quantity#QuantityInterval
<http://w3id.org/CEON/ontology/quantity#QuantityInterval> rdf:type owl:Class .


###  http://w3id.org/CEON/ontology/quantity/DismantlingCost
quantity:DismantlingCost rdf:type owl:Class .


###  http://w3id.org/CEON/ontology/quantity/QuantityInterval
quantity:QuantityInterval rdf:type owl:Class ;
                          rdfs:comment "Quantity interval is an interval with two quantity values." ;
                          rdfs:label "Quantity Interval" .


###  http://w3id.org/CEON/ontology/quantity/RecyclingCost
quantity:RecyclingCost rdf:type owl:Class .


###  http://w3id.org/CEON/ontology/resourceODP/Asset
resourceODP:Asset rdf:type owl:Class ;
                  rdfs:comment "Asset is sth that is valuable and useful to be used in activities, or owned by actors." ;
                  rdfs:label "Asset" .


###  http://w3id.org/CEON/ontology/resourceODP/BatchOfObjects
resourceODP:BatchOfObjects rdf:type owl:Class ;
                           rdfs:subClassOf resourceODP:Resource ,
                                           [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                    owl:onProperty resourceODP:hasPhysicalObject ;
                                                                    owl:someValuesFrom resourceODP:PhysicalObject
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty resourceODP:hasPhysicalObject ;
                                                                    owl:allValuesFrom resourceODP:PhysicalObject
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty product:batchOfProduct ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass product:Product
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty resourceODP:batchSize ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ;
                           rdfs:comment "A batch of objects is a collection of physical objects that are of the same type, e.g. a set of items (product instances) adhering to the same product model." ;
                           rdfs:label "Batch Of Objects" .


###  http://w3id.org/CEON/ontology/resourceODP/Constituent
resourceODP:Constituent rdf:type owl:Class ;
                        rdfs:comment "A constituent is a component of object." ;
                        rdfs:label "Constituent" ;
                        rdfs:seeAlso "http://emmo.info/emmo#EMMO_ceaaf9f7_fd11_424b_8fda_9afa186af186" .


###  http://w3id.org/CEON/ontology/resourceODP/DigitalObject
resourceODP:DigitalObject rdf:type owl:Class ;
                          rdfs:subClassOf resourceODP:Resource ;
                          rdfs:comment "A digital object, e.g. a computer file, that is located on some server, hard drive, or on the web. Most often the digital object is the realization of some piece of information." ;
                          rdfs:label "Digital object" .


###  http://w3id.org/CEON/ontology/resourceODP/Information
resourceODP:Information rdf:type owl:Class ;
                        rdfs:subClassOf resourceODP:Asset ;
                        rdfs:comment "Information is an abstract concept that represents any kind of interpretations. For instance, information can be data generated by software systems or data used by people for communications." ;
                        rdfs:label "Information" ;
                        rdfs:seeAlso "http://emmo.info/emmo#EMMO_64c72d00_7582_44ea_a0b5_3a14e50acc36" .


###  http://w3id.org/CEON/ontology/resourceODP/Matter
resourceODP:Matter rdf:type owl:Class ;
                   rdfs:comment "A matter is a physical substance." ;
                   rdfs:label "Matter" ;
                   rdfs:seeAlso "http://emmo.info/emmo#EMMO_5b2222df_4da6_442f_8244_96e9e45887d1" .


###  http://w3id.org/CEON/ontology/resourceODP/PhysicalObject
resourceODP:PhysicalObject rdf:type owl:Class ;
                           rdfs:subClassOf resourceODP:Resource ,
                                           [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                    owl:onProperty resourceODP:hasConstituent ;
                                                                    owl:someValuesFrom resourceODP:Constituent
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty resourceODP:hasConstituent ;
                                                                    owl:allValuesFrom resourceODP:Constituent
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ,
                                           [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                    owl:onProperty resourceODP:hasMatter ;
                                                                    owl:someValuesFrom resourceODP:Matter
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty resourceODP:hasMatter ;
                                                                    owl:allValuesFrom resourceODP:Matter
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                           rdfs:comment "A physical object is a collection of matter." ;
                           rdfs:label "Physical object" .


###  http://w3id.org/CEON/ontology/resourceODP/Resource
resourceODP:Resource rdf:type owl:Class ;
                     rdfs:subClassOf resourceODP:Asset ,
                                     <http://www.w3.org/ns/prov#Entity> ,
                                     [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                              owl:onProperty resourceODP:hasResourceCondition ;
                                                              owl:someValuesFrom resourceODP:ResourceCondition
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty resourceODP:hasResourceCondition ;
                                                              owl:allValuesFrom resourceODP:ResourceCondition
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ,
                                     [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                              owl:onProperty resourceODP:hasResourceProperty ;
                                                              owl:someValuesFrom resourceODP:ResourceProperty
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty resourceODP:hasResourceProperty ;
                                                              owl:allValuesFrom resourceODP:ResourceProperty
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ,
                                     [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                              owl:onProperty resourceODP:hasResourceQuality ;
                                                              owl:someValuesFrom resourceODP:ResourceQuality
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty resourceODP:hasResourceQuality ;
                                                              owl:allValuesFrom resourceODP:ResourceQuality
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                     rdfs:comment "Asset from which a solution is created or implemented. Depending on the context, reference to “resource” includes “raw material”, “feedstock”, “material” or “component”. Resource includes any energy type (e.g. the energy content or energy potential of materials). Note 4 to entry: Resources can be considered concerning both stocks and flows." ,
                                  "Some resources can be specifically associated with processes." ;
                     rdfs:isDefinedBy "ISO 59004:2024 - 3.1.5 resource" ;
                     rdfs:label "Resource" .


###  http://w3id.org/CEON/ontology/resourceODP/ResourceCondition
resourceODP:ResourceCondition rdf:type owl:Class ;
                              rdfs:comment "The status of a resource." ;
                              rdfs:label "Resource Condition" .


###  http://w3id.org/CEON/ontology/resourceODP/ResourceProperty
resourceODP:ResourceProperty rdf:type owl:Class ;
                             rdfs:comment "The characteristics or attribuets of a resource." ;
                             rdfs:label "Resource Property" .


###  http://w3id.org/CEON/ontology/resourceODP/ResourceQuality
resourceODP:ResourceQuality rdf:type owl:Class ;
                            rdfs:comment "Resource quality is derived based on assessments of resources considering the conditions and properties." ;
                            rdfs:label "Resource Quality" .


###  http://w3id.org/CEON/ontology/resourceODP/SetOfObjects
resourceODP:SetOfObjects rdf:type owl:Class ;
                         rdfs:subClassOf resourceODP:Resource ,
                                         [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                  owl:onProperty resourceODP:hasBatch ;
                                                                  owl:someValuesFrom resourceODP:BatchOfObjects
                                                                ]
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty resourceODP:hasBatch ;
                                                                  owl:allValuesFrom resourceODP:BatchOfObjects
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ,
                                         [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                  owl:onProperty resourceODP:hasPhysicalObject ;
                                                                  owl:someValuesFrom resourceODP:PhysicalObject
                                                                ]
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty resourceODP:hasPhysicalObject ;
                                                                  owl:allValuesFrom resourceODP:PhysicalObject
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                         rdfs:comment "A set of objects is a set of physical objects (items) that can be of different types, i.e. different kinds of items." ;
                         rdfs:label "Set of objects" .


