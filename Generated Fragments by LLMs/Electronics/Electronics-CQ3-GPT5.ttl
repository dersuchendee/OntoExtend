@prefix : <http://w3id.org/CEON/demo/electronics/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ns1: <http://qudt.org/schema/qudt/> .
@prefix ns5: <http://w3id.org/CEON/ontology/product/> .

### Classes
:ItemWithStiffness a owl:Class ;
    rdfs:label "Item with Stiffness" ;
    rdfs:comment "A class representing items or products that have a stiffness value." ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ns5:Item 
                          [ a owl:Restriction ;
                            owl:onProperty :hasStiffnessValue ;
                            owl:someValuesFrom :StiffnessValue ] ) ] .

:StiffnessValue a owl:Class ; # GENERATED
    rdfs:label "Stiffness Value" ;
    rdfs:comment "A class representing values of stiffness." ;
    rdfs:subClassOf ns1:QuantityValue .

### Object Properties
:hasStiffnessValue a owl:ObjectProperty ; # GENERATED
    rdfs:label "has stiffness value" ;
    rdfs:comment "A property linking items or products to their stiffness values." ;
    rdfs:domain ns5:Item ;
    rdfs:range :StiffnessValue ;
    rdfs:subPropertyOf ns1:quantityValue .